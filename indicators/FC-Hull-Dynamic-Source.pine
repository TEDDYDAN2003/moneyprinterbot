//@version=6
indicator("FC Dynamic Hull • Audited Session Win Rates • 15 / 30 / 45", "FC Hull WR", overlay=false, dynamic_requests=true, max_bars_back=500, max_labels_count=500, max_lines_count=500)

// Chart labels can appear intrabar. The table enters at confirmed native closes.
// An aligned Hull cross may enter on or after a confirmed MSS/CHoCH; the shift alone is not an entry.
// Raw opposite crosses still exit; an opposite close before TP/active BE is a loss.
const string G = "Hull"
int length = input.int(16, "Length (Hull A and B)", 2, 500, group=G, tooltip="Shared by the chart and the 15m, 30m and 45m studies. Use 16 to match the bot.")
string src = input.string("Dynamic", "Hull A source", options=["Dynamic","Low","High","HL2","Open","Close","HLC3","OHLC4","Custom"], group=G, tooltip="Dynamic: Low Hull A in bullish structure, High Hull A in bearish structure. Hull B always uses close.")
string neutralSrc = input.string("High", "Dynamic before first trend", options=["High","Wait"], group=G, active=src == "Dynamic")
float custom = input.source(hl2, "Custom source", group=G, active=src == "Custom", tooltip="For native timeframe comparisons, use an OHLC-derived price rather than an external indicator plot.")
string tfIn = input.timeframe("", "Structure timeframe (blank = each chart/test timeframe)", group="Structure")
int n = input.int(3, "Swing bars on each side", 1, 50, group="Structure", tooltip="3 means three bars to the left and three to the right confirm a swing. The structure cannot use it before the right-hand bars close.")
bool swings = input.bool(true, "Show swings", group="Display")
bool breaks = input.bool(true, "Show BOS / MSS", group="Display")
int stripWidth = input.int(10, "Trend strip thickness", 1, 20, group="Display")
string marks = input.string("Valid suggestions only", "Chart signals", options=["Valid suggestions only", "All Hull crosses"], group="Display", tooltip="All crosses is a reference view; it does not change entry alerts or the tester.")
bool auditMarks = input.bool(false, "Mark counted test entries and exits", group="Display", tooltip="On a 15m, 30m or 45m chart: orange dot = test entry, cyan dot = its TP. TP/BE/L/? marks the bar where the result is known or the trade must be flat, not the exact exit tick. ? = unproven order.")
const string T = "Win-rate table • one position per timeframe"
float lots = input.float(0.10, "Lot size", minval=0.000001, group=T)
float cash = input.float(10.0, "Target profit per trade (USD)", minval=0.01, group=T)
float usdTick = input.float(0.0, "USD tick value at 1.00 broker lot (0 = auto)", minval=0, group=T, tooltip="Manual: enter the broker’s PROFIT tick value in USD at one lot and the price size of that tick below. Auto estimates from TradingView; it cannot read your MT5 contract. The two feeds must quote the same price scale.")
float brokerTickSize = input.float(0.0, "Price size of that broker tick (0 = chart tick)", minval=0, group=T, active=usdTick > 0, tooltip="This sets the unit for the manual USD tick value. For a USD value already expressed per TradingView minimum tick, leave at 0.")
string inspectTF = input.timeframe("1", "Inspect exits on", options=["1", "5"], group=T, tooltip="1-minute candles give finer ordering. 5 minutes may cover more history. Incomplete data falls back to the whole signal candle. Unknown TP/BE order is reported, never forced to a loss or win.")
float pointIn = input.float(0.0, "Broker point size (0 = chart minimum tick)", minval=0, group=T)
float bePct = input.float(0, "Arm break-even after close at % of TP (0 = immediate)", minval=0, maxval=100, step=1, group=T, tooltip="0 means immediate, not off. Above 0, BE arms from the bar after a favorable SIGNAL candle closes at the threshold. A proven BE counts as a loss; an unchanged opening at the fill is not proof of a retest.")
int startAt = input.time(0, "Test from", group=T, tooltip="Uses the available native history within the date window. Choose a common recent start to compare the same period.")
int endAt = input.time(timestamp("31 Dec 2099 23:59 +0000"), "Test through", group=T)
// Session labels are analytics only. They do not limit entries or exits.
const string S = "Session statistics • entry time"
string asianHours = input.session("0000-0700", "Asian (UTC)", group=S, tooltip="Start is included, end is excluded. Labels use the entry candle’s closing timestamp, not the exit bar. Overnight windows are supported.")
string londonHours = input.session("0800-1600", "London (London time)", group=S, tooltip="Europe/London; follows UK daylight saving time.")
string nyHours = input.session("0800-1700", "New York (New York time)", group=S, tooltip="America/New_York; follows US daylight saving time.")
string kzHours = input.session("1300-1600", "NY–London killzone (London time)", group=S, tooltip="Counts entries inside this window while BOTH London and New York are open. Set 0000–0000 for their entire overlap. A trade can count in multiple session rows, but only once per timeframe in Overall.")

color bull = #4CAF50
color bear = #F23645
color neutral = #9299A4

type Frame
    int closedAt
    int bias
    int eventCode  // Signed: 1 = BOS, 2 = MSS, 3 = initial direction
    int levelAt
    float level
    float guard
    int pivotAt
    float ph
    int hiClass
    bool replaceHi
    float pl
    int loClass
    bool replaceLo

// ── Market structure on native bars of the selected timeframe ──
f_structure(simple int depth) =>
    float ph = ta.pivothigh(high, depth, depth)
    float pl = ta.pivotlow(low, depth, depth)
    int pt = time[depth]

    var float lastH = na
    var int lastHt = na
    var float lastL = na
    var int lastLt = na

    var int dir = 0
    var float hi = na
    var int ht = na
    var float lo = na
    var int lt = na
    var float pullL = na
    var int pullLt = na
    var float pullH = na
    var int pullHt = na
    var float guard = na
    var int gt = na
    var float legTip = na
    var int tipAt = na
    var float lastBreak = na
    var int legStart = na
    var int legOrigin = na
    var int breakWindow = na
    var bool hasLegHi = false
    var bool hasLegLo = false
    var bool hasLegPullH = false
    var bool hasLegPullL = false

    int ev = 0
    int origin = na
    float level = na

    // Test levels known before this candle. A wick or an equal close is not a break.
    if dir != 0 and not na(guard) and dir * (close - guard) < 0
        ev := -2 * dir
        origin := gt
        level := guard
        guard := legTip
        gt := tipAt
    else if dir >= 0 and not na(hi) and close > hi and (dir == 1 or (not na(lastL) and lastL < close))
        ev := dir == 0 ? 3 : 1
        origin := ht
        level := hi
        if dir == 0 or (not na(pullL) and (na(guard) or pullL > guard))
            guard := na(pullL) ? lastL : pullL
            gt := na(pullL) ? lastLt : pullLt
    else if dir <= 0 and not na(lo) and close < lo and (dir == -1 or (not na(lastH) and lastH > close))
        ev := dir == 0 ? -3 : -1
        origin := lt
        level := lo
        if dir == 0 or (not na(pullH) and (na(guard) or pullH < guard))
            guard := na(pullH) ? lastH : pullH
            gt := na(pullH) ? lastHt : pullHt

    if ev != 0
        dir := ev > 0 ? 1 : -1
        lastBreak := level
        legStart := time
        legOrigin := origin
        breakWindow := time[depth]
        hi := na
        lo := na
        pullL := na
        pullH := na
        hasLegHi := false
        hasLegLo := false
        hasLegPullH := false
        hasLegPullL := false
        legTip := dir == 1 ? high : low
        tipAt := time
    else if dir != 0
        float x = dir == 1 ? high : low
        if na(legTip) or dir * (x - legTip) >= 0
            legTip := x
            tipAt := time

    // Trend-aware swing classification + guard promotion after confirmed failed counter-swings.
    int hc = 0
    int lc = 0
    bool replaceHi = false
    bool replaceLo = false

    bool inLeg = na(legStart) or pt >= legStart
    if not na(ph)
        lastH := ph
        lastHt := pt
        if dir > 0 and not na(pullL) and pt > pullLt and (na(guard) or pullL > guard)
            guard := pullL
            gt := pullLt
        bool inBreakHi = dir > 0 and na(hi) and not na(lastBreak) and ph > lastBreak and not na(breakWindow) and pt >= breakWindow and (na(legOrigin) or pt > legOrigin)
        if (inLeg or inBreakHi) and dir >= 0 and (na(lastBreak) or ph > lastBreak) and (na(hi) or ph >= hi)
            hc := dir == 0 ? 3 : 1
            replaceHi := hasLegHi
            hasLegHi := true
            hi := ph
            ht := pt
            pullL := na
            hasLegPullL := false
        if inLeg and dir <= 0 and not na(lo) and pt > lt and (na(pullH) or ph >= pullH)
            if dir < 0
                hc := -1
                replaceHi := hasLegPullH
                hasLegPullH := true
                hasLegLo := false
            pullH := ph
            pullHt := pt
    if not na(pl)
        lastL := pl
        lastLt := pt
        if dir < 0 and not na(pullH) and pt > pullHt and (na(guard) or pullH < guard)
            guard := pullH
            gt := pullHt
        bool inBreakLo = dir < 0 and na(lo) and not na(lastBreak) and pl < lastBreak and not na(breakWindow) and pt >= breakWindow and (na(legOrigin) or pt > legOrigin)
        if (inLeg or inBreakLo) and dir <= 0 and (na(lastBreak) or pl < lastBreak) and (na(lo) or pl <= lo)
            lc := dir == 0 ? 3 : -1
            replaceLo := hasLegLo
            hasLegLo := true
            lo := pl
            lt := pt
            pullH := na
            hasLegPullH := false
        if inLeg and dir >= 0 and not na(hi) and pt > ht and (na(pullL) or pl <= pullL)
            if dir > 0
                lc := 1
                replaceLo := hasLegPullL
                hasLegPullL := true
                hasLegHi := false
            pullL := pl
            pullLt := pt

    Frame.new(time_close, dir, ev, origin, level, guard, pt, ph, hc, replaceHi, pl, lc, replaceLo)

// Draw every confirmed chart/structure event, including nested lower-TF events.
f_draw(Frame s, label activeHiLbl, label activeLoLbl) =>
    label nextHi = activeHiLbl
    label nextLo = activeLoLbl
    if s.eventCode != 0
        nextHi := na
        nextLo := na
    if swings and s.hiClass != 0
        if s.replaceHi and not na(nextHi)
            label.delete(nextHi)
        string tagH = s.hiClass == 3 ? "H" : s.hiClass == 1 ? "HH" : "LH"
        nextHi := label.new(s.pivotAt, s.ph, tagH, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.white, 100), textcolor=s.hiClass == 1 ? bull : s.hiClass == -1 ? bear : neutral, size=size.tiny, tooltip="Swing high. Confirmed later, on the close of its final right-hand bar.", force_overlay=true)
    if swings and s.loClass != 0
        if s.replaceLo and not na(nextLo)
            label.delete(nextLo)
        string tagL = s.loClass == 3 ? "L" : s.loClass == 1 ? "HL" : "LL"
        nextLo := label.new(s.pivotAt, s.pl, tagL, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(color.white, 100), textcolor=s.loClass == 1 ? bull : s.loClass == -1 ? bear : neutral, size=size.tiny, tooltip="Swing low. Confirmed later, on the close of its final right-hand bar.", force_overlay=true)
    if breaks and s.eventCode != 0
        int k = math.abs(s.eventCode)
        color c = s.eventCode > 0 ? bull : bear
        string name = (k == 2 ? "MSS" : k == 1 ? "BOS" : "INIT") + (s.eventCode > 0 ? " ↑" : " ↓")
        line.new(s.levelAt, s.level, s.closedAt, s.level, xloc=xloc.bar_time, color=c, style=line.style_solid, width=k == 2 ? 2 : 1, force_overlay=true)
        label.new(s.closedAt, s.level, name, xloc=xloc.bar_time, style=s.eventCode > 0 ? label.style_label_down : label.style_label_up, color=color.new(color.white, 100), textcolor=c, size=size.tiny, tooltip="Confirmed structure-timeframe close, not a Hull entry.", force_overlay=true)
    [nextHi, nextLo]

f_a(float x, simple int half, simple int root) =>
    ta.wma(2 * ta.wma(x, half) - ta.wma(x, length), root)

f_hull(int bias) =>
    int half = math.max(1, math.floor(length / 2))
    int root = math.max(1, math.round(math.sqrt(length)))
    float lowA = f_a(low, half, root)
    float highA = f_a(high, half, root)
    float fixedPrice = switch src
        "Custom" => custom
        "Open"   => open
        "Close"  => close
        "HLC3"   => hlc3
        "OHLC4"  => ohlc4
        => hl2
    float fixedA = f_a(fixedPrice, half, root)
    float b = ta.wma(3 * ta.wma(close, math.max(1, math.floor(half / 3))) - ta.wma(close, math.max(1, math.floor(half / 2))) - ta.wma(close, half), half)
    int pick = switch src
        "Dynamic" => bias == 1 ? 1 : (bias == -1 or neutralSrc == "High") ? -1 : 0
        "Low"     => 1
        "High"    => -1
        => 2
    float a = pick == 1 ? lowA : pick == -1 ? highA : pick == 2 ? fixedA : na
    // Compare to the currently selected curve’s OWN history, even on a source switch.
    float prev = pick == 1 ? lowA[1] : pick == -1 ? highA[1] : pick == 2 ? fixedA[1] : na
    int raw = b > a and b[1] < prev ? 1 : b < a and b[1] > prev ? -1 : 0
    [raw, a, b, pick]

// These context series are re-evaluated on each requested signal timeframe.
// Chart (blank) means each row uses ITS OWN structure, not the host's direction.
string structTF = tfIn == "" ? timeframe.period : tfIn
int signalSec = timeframe.in_seconds()
int structSec = timeframe.in_seconds(structTF)
bool higher = structSec > signalSec
bool lower = structSec < signalSec
bool nested = not lower or signalSec % structSec == 0
Frame native = f_structure(n)
// Offset INSIDE the higher-TF request: only information available at chart open.
f_priorHigher() =>
    Frame result = na
    if tfIn != ""
        [previous, stamp] = request.security(syminfo.tickerid, higher ? structTF : timeframe.period, [native[1], time_close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
        if not na(previous) and previous.closedAt == stamp
            result := previous
    result
Frame prevHigher = f_priorHigher()
// On a finished signal bar, use the last nested intrabar’s bias. Drawings use ALL intrabars.
Frame lastLower = tfIn == "" ? na : request.security(syminfo.tickerid, lower ? structTF : timeframe.period, native, lookahead=barmerge.lookahead_off)
Frame studyFrame = not nested ? na : higher ? prevHigher : lower ? lastLower : native
int studyAsOf = higher ? time : time_close

if barstate.isfirst
    if not chart.is_standard or na(signalSec)
        runtime.error("Use a standard time-based candlestick chart.")
    if not nested
        runtime.error("The lower structure timeframe must nest inside the chart timeframe (or select Chart).")
    if startAt > endAt
        runtime.error("Test through must not precede Test from.")
var int dir = 0
var int seen = na
var label lastHLabel = na
var label lastLLabel = na
int cutoff = barstate.isrealtime ? math.min(timenow, time_close) : time_close
array<Frame> updates = array.new<Frame>()
if tfIn != ""
    array<Frame> intrabars = request.security_lower_tf(syminfo.tickerid, lower ? structTF : timeframe.period, native)
    if lower
        updates := intrabars
if higher
    if not na(prevHigher) and prevHigher.closedAt <= time
        updates.push(prevHigher)
else if not lower and barstate.isconfirmed
    updates.push(native)
for s in updates
    if not na(s) and s.closedAt <= cutoff and (na(seen) or s.closedAt > seen)
        [h, l] = f_draw(s, lastHLabel, lastLLabel)
        lastHLabel := h
        lastLLabel := l
        dir := s.bias
        seen := s.closedAt

[raw, a, b, pick] = f_hull(dir)
bool buy = raw == 1 and dir == 1
bool sell = raw == -1 and dir == -1
color ink = na(a) ? neutral : b > a ? bull : bear
pB = plot(b, "Hull B", color=ink, force_overlay=true)
pL = plot(pick == 1 ? a : na, "Hull A Low", color=ink, style=plot.style_linebr, force_overlay=true)
pH = plot(pick == -1 ? a : na, "Hull A High", color=ink, style=plot.style_linebr, force_overlay=true)
pF = plot(pick == 2 ? a : na, "Hull A fixed", color=ink, style=plot.style_linebr, force_overlay=true)
fill(pL, pB, pick == 1 ? color.new(ink, 80) : na, fillgaps=false)
fill(pH, pB, pick == -1 ? color.new(ink, 80) : na, fillgaps=false)
fill(pF, pB, pick == 2 ? color.new(ink, 80) : na, fillgaps=false)
bool allCrosses = marks == "All Hull crosses"
plotshape(allCrosses ? raw == 1 : buy, "BUY", shape.labelup, location.belowbar, bull, text="BUY", textcolor=color.white, size=size.tiny, force_overlay=true)
plotshape(allCrosses ? raw == -1 : sell, "SELL", shape.labeldown, location.abovebar, bear, text="SELL", textcolor=color.white, size=size.tiny, force_overlay=true)
alertcondition(buy, "Hull BUY entry", "BUY | {{ticker}} | {{interval}}")
alertcondition(sell, "Hull SELL entry", "SELL | {{ticker}} | {{interval}}")
alertcondition(raw == 1, "Raw BUY: exit short", "EXIT SHORT | {{ticker}} | {{interval}}")
alertcondition(raw == -1, "Raw SELL: exit long", "EXIT LONG | {{ticker}} | {{interval}}")
color band = dir == 1 ? bull : dir == -1 ? bear : neutral
plot(0, "Internal structure", color=band, linewidth=stripWidth, display=display.pane)
bgcolor(dir == 0 ? na : color.new(band, 88))
plot(dir, "Internal bias (+1 / 0 / −1)", color=band, display=display.status_line + display.data_window)
plot(pick, "Source: 1 Low / -1 High / 2 fixed / 0 waiting", display=display.data_window)

// Independent native bars and position per row; the host chart only displays snapshots.
// Historical entries and opposite exits use confirmed closes, not reconstructed ticks.
// TP/BE are levels, not the live bot’s broker SL, fees, spread or 70/30 ladder.
type Row
    int endTime
    int wins
    int losses
    int beLosses
    int side
    float entry
    float target
    float points
    bool validTF
    bool priced
    int asianW
    int asianN
    int londonW
    int londonN
    int nyW
    int nyN
    int kzW
    int kzN
    int unknown = 0
    int asianU = 0
    int londonU = 0
    int nyU = 0
    int kzU = 0
    int mixedLoss = 0
    int fineBars = 0
    int coarseBars = 0
    bool possibleBE = false
    int heldSignals = 0
    int firstTestClose = na
    int lastTestClose = na
    bool entered = false
    int exitCode = 0
    int missedSizing = 0

// No intrabar arrays leave their native signal context. The panel receives scalar snapshots.
type MinutePrint
    int t0 = time
    int t1 = time_close
    float o = open
    float h = high
    float l = low
    float c = close

// Outcomes: 1 = proven TP, 2 = flat with unknown TP/BE order, 0 = keep the slot,
// -1 = proven active BE, -2 = opposite close, -3 = BE OR opposite (definite non-win).
const int TAKE = 1
const int UNCLEAR = 2
const int BE = -1
const int OPP = -2
const int LOSS_EITHER = -3

f_ticks() =>
    float tickUSD = usdTick
    if tickUSD == 0
        bool otc = syminfo.type == "forex" or syminfo.type == "cfd" or syminfo.type == "spot"
        float units = otc and syminfo.basecurrency == "XAU" ? 100.0 : otc and syminfo.basecurrency == "XAG" ? 5000.0 : syminfo.type == "forex" ? 100000.0 : syminfo.pointvalue
        float fx = syminfo.currency == "USD" ? 1.0 : request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency=true)
        tickUSD := syminfo.mintick * units * fx
    float cashTickSize = usdTick > 0 and brokerTickSize > 0 ? brokerTickSize : syminfo.mintick
    // Remove float noise at exact whole ticks (e.g. 0.07 / 0.01).
    int cashTicks = tickUSD > 0 ? math.max(1, math.ceil(math.round(cash / (lots * tickUSD), 9))) : int(na)
    // Reach a whole broker tick, then the first observable chart tick at/through it.
    not na(cashTicks) ? math.max(1, math.ceil(math.round(cashTicks * cashTickSize / syminfo.mintick, 8))) : int(na)

f_grid(float px) =>
    math.round(px / syminfo.mintick)

// For a still-possible position, reason from the OPEN first. Do not invent an
// O→H→L or O→L→H path. `possible` means an earlier BE is possible, NOT proven.
f_piece(int d, int entryGrid, int goal, bool armed, bool away, bool possible, float o, float h, float l, float c) =>
    int op = d * (f_grid(o) - entryGrid)
    int best = d * (f_grid(d == 1 ? h : l) - entryGrid)
    int worst = d * (f_grid(d == 1 ? l : h) - entryGrid)
    int cp = d * (f_grid(c) - entryGrid)
    int verdict = 0
    bool maybe = possible
    if op >= goal
        verdict := possible ? UNCLEAR : TAKE
    else if armed and (op < 0 or (op == 0 and away))
        verdict := BE
    else if best >= goal
        // If goal is one tick, no favorable price exists strictly between fill and TP.
        bool couldStopFirst = armed and (worst < 0 or (worst == 0 and (op > 0 or away or goal > 1)))
        verdict := possible or couldStopFirst ? UNCLEAR : TAKE
    else if armed and (worst < 0 or (worst == 0 and (op > 0 or away or (best > 0 and cp == 0))))
        verdict := BE
    else if armed and not away and op == 0 and worst == 0 and best > 0
        // Low=opening fill is not evidence of a retest. Both a direct move and a
        // hidden retest fit this small bar. Carry that uncertainty across bars.
        maybe := true
    [verdict, away or best != 0 or worst != 0, maybe]

// Reject partial, shifted or inconsistent lower-timeframe history. An early TP
// in a partial list must NOT outrank a potential earlier BE in a missing minute.
f_covered(array<MinutePrint> xs) =>
    int count = na(xs) ? 0 : xs.size()
    int maxMs = timeframe.in_seconds(inspectTF) * 1000
    bool ok = count > 0 and time_close > time and not na(open) and not na(high) and not na(low) and not na(close)
    if ok
        int cursor = time
        int hiGrid = f_grid(low)
        int loGrid = f_grid(high)
        for m in xs
            if na(m) or na(m.t0) or na(m.t1) or m.t0 != cursor or m.t1 <= m.t0 or m.t1 > time_close or m.t1 - m.t0 > maxMs
                ok := false
                break
            if na(m.o) or na(m.h) or na(m.l) or na(m.c) or m.h < math.max(m.o, m.c) or m.l > math.min(m.o, m.c)
                ok := false
                break
            hiGrid := math.max(hiGrid, f_grid(m.h))
            loGrid := math.min(loGrid, f_grid(m.l))
            cursor := m.t1
        if ok
            MinutePrint head = xs.first()
            MinutePrint tail = xs.last()
            ok := cursor == time_close and f_grid(head.o) == f_grid(open) and f_grid(tail.c) == f_grid(close) and hiGrid == f_grid(high) and loGrid == f_grid(low)
    ok

f_exit(int d, float entry, int goal, bool armed, bool away, bool possible, int rawSignal, array<MinutePrint> xs) =>
    int entryGrid = f_grid(entry)
    int verdict = 0
    bool left = away
    bool maybe = possible
    bool fine = f_covered(xs)
    if fine
        for m in xs
            [e, a, b] = f_piece(d, entryGrid, goal, armed, left, maybe, m.o, m.h, m.l, m.c)
            verdict := e
            left := a
            maybe := b
            if verdict != 0
                break
    else
        // The whole native candle still proves gaps and one-sided touches.
        [e, a, b] = f_piece(d, entryGrid, goal, armed, left, maybe, open, high, low, close)
        verdict := e
        left := a
        maybe := b
    // The raw opposite occurs at the SIGNAL candle close, never at a microbar close.
    if verdict == 0 and rawSignal == -d
        verdict := maybe ? LOSS_EITHER : OPP
    [verdict, left, maybe, fine]

// Test the actual fill instant in local wall-clock minutes. Using time(..., session)
// would classify the chart bar's OPEN and mislabel close fills on a boundary.
f_bound(simple string hours, simple int offset) =>
    int(str.tonumber(str.substring(hours, offset, offset + 2))) * 60 + int(str.tonumber(str.substring(hours, offset + 2, offset + 4)))

f_inside(int localMinute, simple string hours) =>
    int first = f_bound(hours, 0)
    int last = f_bound(hours, 5)
    if first == last
        true
    else if first < last
        localMinute >= first and localMinute < last
    else
        localMinute >= first or localMinute < last

f_clock(int stamp, simple string tz) =>
    hour(stamp, tz) * 60 + minute(stamp, tz)

f_tags(int stamp) =>
    int uk = f_clock(stamp, "Europe/London")
    bool asia = f_inside(f_clock(stamp, "UTC"), asianHours)
    bool london = f_inside(uk, londonHours)
    bool ny = f_inside(f_clock(stamp, "America/New_York"), nyHours)
    bool killzone = london and ny and f_inside(uk, kzHours)
    [asia, london, ny, killzone]

// Decisions and frozen entry/session data live independently in each 15/30/45m book.
f_score(int signal, int bias, int ticks, bool valid, array<MinutePrint> xs) =>
    bool inTest = time_close >= startAt and time_close <= endAt and valid
    float distancePts = ticks * syminfo.mintick / (pointIn > 0 ? pointIn : syminfo.mintick)
    var int d = 0
    var int wins = 0
    var int losses = 0
    var int be = 0
    var int mixed = 0
    var int unknown = 0
    var int asianW = 0
    var int asianN = 0
    var int asianU = 0
    var int londonW = 0
    var int londonN = 0
    var int londonU = 0
    var int nyW = 0
    var int nyN = 0
    var int nyU = 0
    var int kzW = 0
    var int kzN = 0
    var int kzU = 0
    var bool fromAsia = false
    var bool fromLondon = false
    var bool fromNY = false
    var bool fromKZ = false
    var float entry = na
    var float target = na
    var float points = na
    var int targetTicks = na
    var bool away = false
    var bool armed = false
    var bool possibleBE = false
    var int fineBars = 0
    var int coarseBars = 0
    var int heldSignals = 0
    var int firstTestClose = na
    var int lastTestClose = na
    var bool sawPrice = false
    var int missedSizing = 0
    bool entered = false
    int exitCode = 0
    if inTest
        sawPrice := sawPrice or not na(ticks)
        if na(firstTestClose)
            firstTestClose := time_close
        lastTestClose := time_close
    if inTest and d != 0
        [outcome, leftNow, maybeNow, fine] = f_exit(d, entry, targetTicks, armed, away, possibleBE, signal, xs)
        fineBars += fine ? 1 : 0
        coarseBars += fine ? 0 : 1
        exitCode := outcome
        if outcome != 0
            int w = outcome == TAKE ? 1 : 0
            int u = outcome == UNCLEAR ? 1 : 0
            wins += w
            losses += outcome < 0 ? 1 : 0
            be += outcome == BE ? 1 : 0
            mixed += outcome == LOSS_EITHER ? 1 : 0
            unknown += u
            // Count this completed case ONCE before a new close can change its tags.
            if fromAsia
                asianW += w
                asianU += u
                asianN += 1
            if fromLondon
                londonW += w
                londonU += u
                londonN += 1
            if fromNY
                nyW += w
                nyU += u
                nyN += 1
            if fromKZ
                kzW += w
                kzU += u
                kzN += 1
            d := 0
            possibleBE := false
        else
            // Threshold > 0 arms only AFTER the qualifying native close, never its wick.
            int gain = d * (f_grid(close) - f_grid(entry))
            armed := armed or gain >= math.ceil(targetTicks * bePct / 100.0)
            away := leftNow
            possibleBE := maybeNow
            // One slot: no invented re-entry when an earlier stop is only possible.
            if possibleBE and signal == d and bias == d and not na(ticks)
                heldSignals += 1
    // A missing USD conversion/contract must not masquerade as zero trades or a full rate.
    if inTest and d == 0 and signal != 0 and signal == bias and na(ticks)
        missedSizing += 1
    // Entry at the confirmed close, AFTER the native candle's entire exit check.
    if inTest and d == 0 and signal != 0 and signal == bias and not na(ticks)
        entered := true
        [tagA, tagL, tagN, tagK] = f_tags(time_close)
        fromAsia := tagA
        fromLondon := tagL
        fromNY := tagN
        fromKZ := tagK
        d := signal
        entry := close
        targetTicks := ticks
        target := math.round_to_mintick(entry + d * targetTicks * syminfo.mintick)
        points := distancePts
        away := false
        possibleBE := false
        armed := bePct == 0
    Row.new(time_close, wins, losses, be, d, entry, target, na(points) ? distancePts : points, valid, sawPrice, asianW, asianN, londonW, londonN, nyW, nyN, kzW, kzN, unknown, asianU, londonU, nyU, kzU, mixed, fineBars, coarseBars, possibleBE, heldSignals, firstTestClose, lastTestClose, entered, exitCode, missedSizing)

// Explicitly requested from WITHIN each native signal context (Pine v6 dynamic requests).
// Other host intervals need no micro history of their own just to display the table.
f_slices() =>
    array<MinutePrint> xs = array.new<MinutePrint>()
    if signalSec == 900 or signalSec == 1800 or signalSec == 2700
        xs := request.security_lower_tf(syminfo.tickerid, inspectTF, MinutePrint.new(), ignore_invalid_timeframe=true)
    xs

f_study() =>
    var int bias = 0
    if not na(studyFrame) and studyFrame.closedAt <= studyAsOf
        bias := studyFrame.bias
    [signal, _, _, _] = f_hull(bias)
    array<MinutePrint> parts = f_slices()
    f_score(signal, bias, f_ticks(), nested, parts)

// lookahead_off: on a larger host chart this samples the last native intrabar,
// whose counters include ALL earlier native bars. Never display a developing row.
Row book = f_study()
[c15, p15] = request.security(syminfo.tickerid, "15", [book, book[1]], lookahead=barmerge.lookahead_off)
[c30, p30] = request.security(syminfo.tickerid, "30", [book, book[1]], lookahead=barmerge.lookahead_off)
[c45, p45] = request.security(syminfo.tickerid, "45", [book, book[1]], lookahead=barmerge.lookahead_off)

f_closed(Row current, Row previous, int asOf) =>
    not na(current) and current.endTime <= asOf ? current : not na(previous) and previous.endTime <= asOf ? previous : na

// Optional visual audit of this exact book, on a matching native chart only.
// Entry/TP dots belong to the new entry. Exit symbols describe the old trade
// and mark the candle that settles its status, not an invented exit time.
bool auditHere = auditMarks and barstate.isconfirmed and (signalSec == 900 or signalSec == 1800 or signalSec == 2700)
plot(auditHere and book.entered ? book.entry : na, "Test entry at close", color=#FFB74D, linewidth=3, style=plot.style_circles, force_overlay=true)
plot(auditHere and book.entered ? book.target : na, "Target for that test entry", color=#26C6DA, linewidth=3, style=plot.style_circles, force_overlay=true)
plotshape(auditHere and book.exitCode == TAKE, "Test: proven TP", shape.diamond, location.abovebar, bull, text="TP", textcolor=bull, size=size.tiny, force_overlay=true)
plotshape(auditHere and book.exitCode == BE, "Test: proven BE", shape.xcross, location.abovebar, bear, text="BE", textcolor=bear, size=size.tiny, force_overlay=true)
plotshape(auditHere and (book.exitCode == OPP or book.exitCode == LOSS_EITHER), "Test: definite non-win at or before opposite close", shape.xcross, location.abovebar, bear, text="L", textcolor=bear, size=size.tiny, force_overlay=true)
plotshape(auditHere and book.exitCode == UNCLEAR, "Test: unknown TP/BE order", shape.diamond, location.abovebar, #CE93D8, text="?", textcolor=#CE93D8, size=size.tiny, force_overlay=true)

f_inWindow(Row r) =>
    not na(r) and r.validTF and not na(r.firstTestClose)

f_ok(Row r) =>
    f_inWindow(r) and r.priced and r.missedSizing == 0

f_counts(Row r, int g) =>
    int w = na
    int nClosed = na
    int u = na
    if f_ok(r)
        w := g == 0 ? r.wins : g == 1 ? r.asianW : g == 2 ? r.londonW : g == 3 ? r.nyW : r.kzW
        nClosed := g == 0 ? r.wins + r.losses + r.unknown : g == 1 ? r.asianN : g == 2 ? r.londonN : g == 3 ? r.nyN : r.kzN
        u := g == 0 ? r.unknown : g == 1 ? r.asianU : g == 2 ? r.londonU : g == 3 ? r.nyU : r.kzU
    [w, nClosed, u]

const string countTip = "n = finished test trades, including unknown outcomes. With ? cases, the lower end counts none as wins; the upper end counts all as wins. Held slots are excluded. Bounds describe counted entries only, not a different entry list after a possible stop. Sessions overlap; Overall counts each case once per timeframe."
const string poolTip = "All TFs sums case counts before computing rates. The three independent tests are not a deduplicated portfolio."
var table panel = table.new(position.top_right, 5, 10, bgcolor=#18212C, frame_color=#465567, frame_width=1, force_overlay=true)

f_cell(int col, int row, string value, string tip) =>
    color bg = row == 0 ? #263547 : row == 1 ? #203B41 : col == 4 ? #263341 : row % 2 == 0 ? #17212C : #1E2A37
    color fg = row == 0 or row == 1 ? color.white : col == 4 ? #A6DEDD : col == 0 ? color.silver : #E8EDF3
    table.cell(panel, col, row, value, text_color=fg, text_size=size.small, bgcolor=bg, text_halign=col == 0 ? text.align_left : text.align_center, tooltip=tip)

f_rateCell(int col, int row, int w, int total, int u, string note) =>
    string value = "n/a"
    string detail = col == 4 ? "Needs usable snapshots for all three timeframes." : "No in-window closes, incompatible structure timeframe or unavailable sizing (see TP Δ / pts)."
    if not na(total)
        value := "— (0)"
        detail := "No finished trades."
        if total > 0
            string pct = str.tostring(100.0 * w / total, "0.0")
            if u > 0
                // Round a RANGE outwards: the displayed endpoints still contain the data.
                float lowerPct = math.floor(1000.0 * w / total) / 10.0
                float upperPct = math.ceil(1000.0 * (w + u) / total) / 10.0
                pct := str.tostring(lowerPct, "0.0") + "–" + str.tostring(upperPct, "0.0")
            value := pct + "% (" + str.tostring(total) + ")"
            detail := "TP: " + str.tostring(w) + " | Loss: " + str.tostring(total - w - u) + " | Unknown: " + str.tostring(u)
    f_cell(col, row, value, note + "\n" + detail + "\n" + countTip)

f_wlu(int w, int l, int u) =>
    str.tostring(w) + " / " + str.tostring(l) + " / " + str.tostring(u)

f_coverage(int fine, int coarse) =>
    fine + coarse == 0 ? "—" : str.tostring(100.0 * fine / (fine + coarse), "0.0") + "%"

f_footer(int col, Row r) =>
    bool ok = f_ok(r)
    bool ready = f_inWindow(r)
    string unavailable = not ready ? "No in-window native closes or non-nested structure timeframe." : "Missing TP sizing. Unpriced entry signals: " + str.tostring(r.missedSizing) + ". Set the broker’s USD tick value and tick size to rerun."
    string exits = ok ? "BE: " + str.tostring(r.beLosses) + " | Opposite: " + str.tostring(r.losses - r.beLosses - r.mixedLoss) + " | BE or opposite (definite loss): " + str.tostring(r.mixedLoss) + "\nUnknown TP vs BE: " + str.tostring(r.unknown) : unavailable
    string cover = ok ? str.tostring(r.fineBars) + " held bars inspected on " + inspectTF + "m; " + str.tostring(r.coarseBars) + " used whole-candle evidence only.\nIn-window closes (UTC): " + str.format_time(r.firstTestClose, "yyyy-MM-dd HH:mm", "UTC") + " → " + str.format_time(r.lastTestClose, "yyyy-MM-dd HH:mm", "UTC") : unavailable
    string side = not ok ? "n/a" : r.side == 0 ? "flat" : (r.side == 1 ? "BUY" : "SELL") + (r.possibleBE ? "?" : "")
    float delta = not ok ? na : not na(r.entry) ? math.abs(r.target - r.entry) : r.points * (pointIn > 0 ? pointIn : syminfo.mintick)
    string distance = not ready ? "n/a" : not ok or na(delta) ? "Set tick $" : str.tostring(delta, format.mintick) + " / " + str.tostring(r.points, "#.##")
    float tickUnit = brokerTickSize > 0 ? brokerTickSize : syminfo.mintick
    string unit = usdTick > 0 ? "Manual: $" + str.tostring(usdTick, "#.########") + " per " + str.tostring(tickUnit, "#.########") + " price change at 1 lot. Feeds must share a price scale." : "Auto: TradingView contract estimate, not a verified MT5 lot."
    string sizing = "$" + str.tostring(cash, "#.##") + " gross target at " + str.tostring(lots, "#.######") + " lot(s). " + unit
    string prices = not ok ? unavailable : not na(r.entry) ? "Last fill: " + str.tostring(r.entry, format.mintick) + " | TP: " + str.tostring(r.target, format.mintick) : "No entry in range."
    f_cell(col, 6, ok ? f_wlu(r.wins, r.losses, r.unknown) : "n/a", exits)
    f_cell(col, 7, ok ? f_coverage(r.fineBars, r.coarseBars) : "n/a", cover)
    f_cell(col, 8, distance, prices + "\n" + sizing)
    f_cell(col, 9, side, ok ? "? = could already have stopped; slot stays reserved until closure is certain. Extra same-side candidates withheld under that uncertainty: " + str.tostring(r.heldSignals) : unavailable)

f_panel(Row r15, Row r30, Row r45) =>
    f_cell(0, 0, "Win rate (n)", countTip)
    f_cell(1, 0, "15m", countTip)
    f_cell(2, 0, "30m", countTip)
    f_cell(3, 0, "45m", countTip)
    f_cell(4, 0, "All TFs", poolTip)
    for g = 0 to 4
        string name = g == 0 ? "Overall" : g == 1 ? "Asian" : g == 2 ? "London" : g == 3 ? "New York" : "NY–London KZ"
        string window = g == 0 ? "All entries, including outside the named sessions." : g == 1 ? asianHours + " UTC" : g == 2 ? londonHours + " Europe/London" : g == 3 ? nyHours + " America/New_York" : kzHours + " Europe/London inside the overlap."
        int y = g + 1
        [w15, n15, u15] = f_counts(r15, g)
        [w30, n30, u30] = f_counts(r30, g)
        [w45, n45, u45] = f_counts(r45, g)
        f_cell(0, y, name, window + "\n" + countTip)
        f_rateCell(1, y, w15, n15, u15, window)
        f_rateCell(2, y, w30, n30, u30, window)
        f_rateCell(3, y, w45, n45, u45, window)
        f_rateCell(4, y, w15 + w30 + w45, n15 + n30 + n45, u15 + u30 + u45, poolTip + "\n" + window)
    f_cell(0, 6, "TP / Loss / ?", "? = trade definitely ended but either TP or BE could have happened first.")
    f_cell(0, 7, inspectTF + "m coverage", "Share of held signal bars with a complete, matching set of inspection candles. Not the share with a known outcome.")
    f_cell(0, 8, "TP Δ / pts", "Price distance / broker points at the last entry. Before the first entry: estimate. No spread, fees, broker SL or ladder.")
    f_cell(0, 9, "Position", "One test slot per timeframe; never a live position report.")
    f_footer(1, r15)
    f_footer(2, r30)
    f_footer(3, r45)
    bool full = f_ok(r15) and f_ok(r30) and f_ok(r45)
    string wlu = full ? f_wlu(r15.wins + r30.wins + r45.wins, r15.losses + r30.losses + r45.losses, r15.unknown + r30.unknown + r45.unknown) : "n/a"
    int slots = full ? (r15.side != 0 ? 1 : 0) + (r30.side != 0 ? 1 : 0) + (r45.side != 0 ? 1 : 0) : na
    f_cell(4, 6, wlu, poolTip)
    f_cell(4, 7, full ? f_coverage(r15.fineBars + r30.fineBars + r45.fineBars, r15.coarseBars + r30.coarseBars + r45.coarseBars) : "n/a", "Held signal bars with complete lower-timeframe data / all evaluated held signal bars, pooled across timeframes.")
    f_cell(4, 8, usdTick > 0 ? "Manual $" : "Auto $", "Verify gross USD per tick at 1.00 lot with your broker. Auto cannot read MT5.")
    f_cell(4, 9, full ? str.tostring(slots) + " held" : "n/a", "Held slots, including any possible earlier BE. These are excluded from the win-rate bounds.")

if barstate.islast
    f_panel(f_closed(c15, p15, cutoff), f_closed(c30, p30, cutoff), f_closed(c45, p45, cutoff))
