//@version=6
indicator("FC Hull Either 16 · BOS Range & CHoCH Retest v3", shorttitle="FC Range 3", overlay=true, max_bars_back=2100, max_lines_count=300, max_labels_count=300)

// Standalone chart study, not an MT5 connection. Native chart candles only.
// Chart-only policy: momentum_retest_v3. The Python scanner still uses protected_swing_v2.
// A countertrend watch is NOT a valid entry. A confirmed reversal may stage a chart limit;
// the first possible fill is on a later candle. No broker API, no forward pivot placement.
const string G_VIEW = "1 · Suggestions and alerts"
const string G_HULL = "2 · Hull signal"
const string G_STRUCT = "3 · Confirmed market structure"
const string G_FILTER = "4 · Chart entry filters"
const string G_RISK = "5 · Chart stops and exits"
const string G_MONEY = "6 · Chart account and costs"
const string G_PLAN = "7 · Chart plans and statistics"

string labelMode = input.string("Valid suggestions only", "Labels and alerts", options=["Valid suggestions only", "Structure only (bands / retests)", "Simulated fills only", "All Hull crosses (debug)"], group=G_VIEW, tooltip="Valid: a trend cross in the BOS-proven half-range, or a simulated reversal limit retest (not the CHoCH close). Structure: band crosses and first retest touches, before chart risk/slot checks. Fills: simulated executions only. Raw: unfiltered diagnostic crosses, including countertrend. No view places orders.")
bool showCross = input.bool(true, "Show signal labels", group=G_VIEW, tooltip="Hides the marks only. The two alert conditions still use the chosen Labels and alerts setting.")
bool showBands = input.bool(false, "Draw active BUY and SELL bands", group=G_VIEW, tooltip="Only bullish discount or bearish premium is an entry band. The former opposite zone may arm a watch, never a countertrend entry.")
bool showStages = input.bool(true, "Show watch / retest-limit levels", group=G_VIEW, tooltip="Gold dots = watch, no order. Blue diamond = limit staged; blue line = still waiting for a retest. Read the Data Window for stage events. Neither is a BUY/SELL fill.")
int hullLen = input.int(16, "Hull length", minval=2, maxval=500, group=G_HULL)
string sourceMode = input.string("Either source", "Signal source mode", options=["Either source", "Directional", "Low only", "High only"], group=G_HULL, tooltip="Either: a strict cross of the Low or High Hull A. Same-direction crosses on one close count once. Opposed crosses on the same close produce no signal.")
bool alternateOnly = input.bool(false, "Require selected BUY and SELL crosses to alternate", group=G_HULL, tooltip="Leave off for the bot's rule: a later fresh same-side cross can qualify once flat. This optional filter operates on crosses, not on filled positions.")
bool showChannel = input.bool(true, "Show High and Low Hull A lines", group=G_HULL)
bool channelFill = input.bool(true, "Shade channel by last displayed signal", group=G_HULL)
int swingLen = input.int(3, "Confirmed swing: bars on EACH side", minval=1, maxval=100, group=G_STRUCT, tooltip="Bot default: 3 left + 3 right. No pivot or earlier signal is drawn back onto the pivot candle.")
bool allowLong = input.bool(true, "Allow BUY suggestions and chart longs", group=G_FILTER)
bool allowShort = input.bool(true, "Allow SELL suggestions and chart shorts", group=G_FILTER)
bool useEma = input.bool(false, "Also require EMA trend for entries", group=G_FILTER, tooltip="Off matches the bot's labels mode. When on, BUY above / SELL below the EMA. Market structure is always required for chart entries.")
int emaLength = input.int(200, "EMA length", minval=1, maxval=2000, group=G_FILTER)
bool showEma = input.bool(true, "Plot EMA when filter is enabled", group=G_FILTER)
string stopMode = input.string("Local pullback (bot)", "Chart stop anchor", options=["Local pullback (bot)", "Confirmed pivot (original chart)"], group=G_RISK)
int pullbackBars = input.int(7, "Local pullback: prior bars", minval=1, maxval=100, group=G_RISK, tooltip="Exclude the signal bar. Do not look farther back than the last selected opposite cross.")
int atrLength = input.int(14, "Wilder ATR length", minval=1, maxval=500, group=G_RISK)
float atrBuffer = input.float(0.1, "Stop buffer × ATR", minval=0, maxval=100, step=0.05, group=G_RISK)
float pipSize = input.float(0.01, "Pip size in price units", minval=0.00000001, maxval=1000, step=0.00001, group=G_RISK)
float extraPips = input.float(0.0, "Extra stop buffer (pips)", minval=0, maxval=100000, step=0.5, group=G_RISK)
float targetR = input.float(1.5, "Target R multiple", minval=0.1, maxval=100, step=0.1, group=G_RISK, tooltip="Chart target only: measured from the trend signal close, or the reversal retest limit, to its stop. This single-position simulation cannot see MT5 tickets and does not model the bot’s per-ticket 70/30 exits.")
bool exitOpposite = input.bool(true, "Exit chart trade on a selected opposite", group=G_RISK, tooltip="An opposite with a valid stop and optional EMA can close the old position without itself passing structure. A replacement needs all entry checks. Old exits execute first at the next chart open.")

float initialCapital = input.float(10000.0, "Initial capital", minval=0.01, maxval=1000000000, step=100, group=G_MONEY)
float equityPercent = input.float(10.0, "Position value (% of equity)", minval=0.01, maxval=100, step=1, group=G_MONEY, tooltip="Not percent at risk. Units = allocated equity / (entry price × point value).")
float commissionPercent = input.float(0.0, "Commission per side (%)", minval=0, maxval=10, step=0.01, group=G_MONEY)
int slippageTicks = input.int(0, "Adverse slippage (ticks)", minval=0, maxval=10000, group=G_MONEY)
float tickSize = input.float(0.01, "Tick size for slippage", minval=0.00000001, maxval=1000, step=0.00001, group=G_MONEY)
float pointValue = input.float(1.0, "Value of one price unit per simulated unit", minval=0.000001, maxval=1000000, step=0.01, group=G_MONEY)

bool showPlan = input.bool(false, "Draw filled chart plans (entry / SL / TP)", group=G_PLAN)
int planLength = input.int(15, "Plan line length (bars)", minval=3, maxval=200, group=G_PLAN)
int maxPlans = input.int(40, "Most recent plans to keep", minval=1, maxval=100, group=G_PLAN)
bool showTable = input.bool(true, "Show simulation table", group=G_PLAN)
string tableLocation = input.string("top_right", "Table corner", options=["top_right", "top_left", "bottom_right", "bottom_left"], group=G_PLAN)

// Compute on every bar. Zero filling is ONLY for the inner calculation; a
// WMA result is withheld until its entire consecutive input window is valid.
f_wma(float x, simple int n) =>
    float weighted = ta.wma(nz(x, 0.0), n)
    float available = math.sum(na(x) ? 0.0 : 1.0, n)
    available == n ? weighted : na

f_hull_a(float x, simple int n, simple int h, simple int r) =>
    float fast = f_wma(x, h)
    float slow = f_wma(x, n)
    f_wma(2.0 * fast - slow, r)

int halfLen = math.max(1, math.floor(hullLen / 2.0))
int rootLen = math.max(1, math.round(math.sqrt(hullLen)))
int thirdLen = math.max(1, math.floor(halfLen / 3.0))
int halfHalf = math.max(1, math.floor(halfLen / 2.0))

float bFast = f_wma(close, thirdLen)
float bMid = f_wma(close, halfHalf)
float bSlow = f_wma(close, halfLen)
float b = f_wma(3.0 * bFast - bMid - bSlow, halfLen)
float channelHi = f_hull_a(high, hullLen, halfLen, rootLen)
float channelLo = f_hull_a(low, hullLen, halfLen, rootLen)
// Free Chart delegates EMA seeding to its platform helper. Make the convention
// explicit here: start at the first available close, then use alpha = 2/(N+1).
float alpha = 2.0 / (emaLength + 1.0)
var float ema = na
ema := na(ema[1]) ? close : ema[1] + alpha * (close - ema[1])
float atr = ta.atr(atrLength)

// Evaluate both baselines every bar. Do not switch a single WMA's input or
// compare B[1] to a different baseline than B: that can manufacture a cross.
bool lowReady = not na(channelLo) and not na(channelLo[1]) and not na(b) and not na(b[1])
bool highReady = not na(channelHi) and not na(channelHi[1]) and not na(b) and not na(b[1])
// Match FC Hull exactly: equality at this or the previous close is not a crossover.
bool lowBuy = barstate.isconfirmed and lowReady and b > channelLo and b[1] < channelLo[1]
bool lowSell = barstate.isconfirmed and lowReady and b < channelLo and b[1] > channelLo[1]
bool highBuy = barstate.isconfirmed and highReady and b > channelHi and b[1] < channelHi[1]
bool highSell = barstate.isconfirmed and highReady and b < channelHi and b[1] > channelHi[1]

bool buyCandidate = switch sourceMode
    "High only" => highBuy
    "Either source" => lowBuy or highBuy
    => lowBuy
bool sellCandidate = switch sourceMode
    "Low only" => lowSell
    "Either source" => lowSell or highSell
    => highSell
bool conflict = buyCandidate and sellCandidate
int candidate = conflict ? 0 : buyCandidate ? 1 : sellCandidate ? -1 : 0
var int lastSignal = 0
var int buyLabels = 0
var int sellLabels = 0
var int conflicts = 0
var int repeats = 0
bool repeatSkipped = alternateOnly and candidate != 0 and candidate == lastSignal
bool rawBuy = candidate == 1 and not repeatSkipped
bool rawSell = candidate == -1 and not repeatSkipped
if rawBuy
    lastSignal := 1
    buyLabels += 1
else if rawSell
    lastSignal := -1
    sellLabels += 1
else if conflict
    conflicts += 1
else if repeatSkipped
    repeats += 1

// Window [i-2s, i] with candidate i-s. An equal older extreme is OK;
// an equal NEWER extreme wins instead. No lookahead or pivot backdating.
float rightLow = ta.lowest(low, swingLen)
float rightHigh = ta.highest(high, swingLen)
float candidateLow = low[swingLen]
float candidateHigh = high[swingLen]
bool pivotLow = bar_index >= 2 * swingLen and candidateLow <= rightLow[swingLen + 1] and candidateLow < rightLow
bool pivotHigh = bar_index >= 2 * swingLen and candidateHigh >= rightHigh[swingLen + 1] and candidateHigh > rightHigh

f_price(float x) => str.tostring(x, format.mintick)
f_num(float x) => na(x) ? "—" : str.tostring(x, "0.00")

f_level(array<line> lines, array<label> tags, int x1, int x2, float price, string caption, color ink, string stroke) =>
    line ln = line.new(x1, price, x2, price, xloc=xloc.bar_index, color=ink, style=stroke, width=1)
    label tag = label.new(x2, price, caption + " " + f_price(price), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=ink, textcolor=color.white, size=size.tiny)
    array.push(lines, ln)
    array.push(tags, tag)

// protected_swing_v2. Only structural closing breaks change the protected origin.
// 0 none, 1 context, 2 CHoCH, 3 continuation BOS. Never relabel earlier bars.
var float knownH = na
var float knownL = na
var int bias = 0
var int eventKind = 0
var float broken = na
var float origin = na
var float extreme = na
var float runTip = na
var int runTipBar = na
var float legOuter = na
var float retraceWick = na
var int pullbackSeenBar = na
bool breakNow = false
int pivotBar = bar_index - swingLen
if barstate.isconfirmed
    int ns = 0
    int nk = 0
    float nb = na
    float no = na
    if bias == 0
        if not na(knownH) and not na(knownL) and (close > knownH or close < knownL)
            ns := close > knownH ? 1 : -1
            nk := 1
            nb := ns == 1 ? knownH : knownL
            no := ns == 1 ? knownL : knownH
    else if bias * (close - origin) < 0
        ns := -bias
        nk := 2
        nb := origin
        no := legOuter
    else if not na(extreme) and bias * (close - extreme) > 0
        if not na(pullbackSeenBar) and not na(retraceWick)
            ns := bias
            nk := 3
            nb := extreme
            bool promote = bias * (retraceWick - origin) > 0 and bias * (extreme - retraceWick) > 0
            no := promote ? retraceWick : origin
        else
            extreme := na
            runTip := na
            runTipBar := na
            retraceWick := na
            pullbackSeenBar := na
    if nk != 0
        bias := ns
        eventKind := nk
        broken := nb
        origin := no
        extreme := na
        runTip := na
        runTipBar := na
        legOuter := na
        retraceWick := na
        pullbackSeenBar := na
        breakNow := nk >= 2
    if bias != 0
        float wick = bias == 1 ? high : low
        float back = bias == 1 ? low : high
        if na(legOuter) or bias * (wick - legOuter) >= 0
            legOuter := wick
        if na(extreme) and (na(runTip) or bias * (wick - runTip) >= 0)
            runTip := wick
            runTipBar := bar_index
            retraceWick := na
            pullbackSeenBar := na
        else
            if na(retraceWick) or bias * (back - retraceWick) <= 0
                retraceWick := back
            if na(pullbackSeenBar) and not na(close[1]) and bias * (close - close[1]) < 0
                pullbackSeenBar := bar_index
        bool tipPivot = bias == 1 ? pivotHigh : pivotLow
        float tipPx = bias == 1 ? candidateHigh : candidateLow
        if na(extreme) and tipPivot and pivotBar == runTipBar and bias * (tipPx - broken) > 0
            extreme := tipPx
    if pivotHigh
        knownH := candidateHigh
    if pivotLow
        knownL := candidateLow

bool seenPullback = not na(pullbackSeenBar)
float reaction = seenPullback ? retraceWick : na
// Only a proved continuation BOS plus its confirmed outer extreme defines a dealing range.
// No extra internal HL/LH is needed. Equality at the midpoint is allowed; the guard is strict.
bool rangeReady = eventKind == 3 and not na(origin) and not na(extreme) and bias * (extreme - origin) > 0
float midRange = rangeReady ? math.round((origin + extreme) * 0.5, 9) : na
float buyLo = rangeReady and bias == 1 ? origin : na
float buyHi = rangeReady and bias == 1 ? midRange : na
float sellLo = rangeReady and bias == -1 ? midRange : na
float sellHi = rangeReady and bias == -1 ? origin : na
bool strictBuyLo = true
bool strictBuyHi = false
bool strictSellLo = false
bool strictSellHi = true
f_inside(float px, float lo, float hi, bool openLo, bool openHi) =>
    not na(px) and not na(lo) and not na(hi) and (openLo ? px > lo : px >= lo) and (openHi ? px < hi : px <= hi)
int selected = rawBuy ? 1 : rawSell ? -1 : 0
bool insideBuy = f_inside(close, buyLo, buyHi, true, false)
bool insideSell = f_inside(close, sellLo, sellHi, false, true)
int trendSide = rawBuy and insideBuy ? 1 : rawSell and insideSell ? -1 : 0

// Watch and retest are separate from the ordinary one-shot next-open continuation plan.
var int watchSide = 0
var float watchGuard = na
var int retSide = 0
var float retLevel = na
var int retBar = na
var bool retOK = false
var float retSL = na
var float retTP = na
int armedNow = 0
int confirmNow = 0
int placedNow = 0
int cancelledNow = 0
int touched = 0
float touchedPx = na
float touchedSL = na
float touchedTP = na
bool touchedOK = false
int retestFill = 0
bool gapInTape = bar_index > 0 and time != time_close[1]
bool chochClose = breakNow and eventKind == 2
if barstate.isconfirmed
    // Process the order from the PREVIOUS close, before this bar's close-only signals.
    if retSide != 0
        if not gapInTape and bar_index > retBar and (retSide == 1 ? low <= retLevel : high >= retLevel)
            touched := retSide
            touchedPx := retLevel
            touchedOK := retOK
            touchedSL := retSL
            touchedTP := retTP
            retSide := 0
        else if gapInTape or candidate == -retSide or conflict or breakNow or bias != retSide
            cancelledNow := retSide
            retSide := 0
        if retSide == 0
            retLevel := na
            retBar := na
            retOK := false
            retSL := na
            retTP := na
    // An opposing raw direction cancels even if it would not pass entry/EMA/alternation.
    if watchSide != 0 and (gapInTape or candidate == -watchSide or conflict)
        cancelledNow := watchSide
        watchSide := 0
        watchGuard := na
    if chochClose
        bool stored = watchSide == bias and not na(watchGuard) and watchGuard == broken
        if not conflict and candidate != -bias and (stored or selected == bias)
            confirmNow := bias
        if watchSide != 0 and not stored
            cancelledNow := watchSide
        watchSide := 0
        watchGuard := na
    else
        if watchSide != 0 and (breakNow or not rangeReady or bias != -watchSide or origin != watchGuard)
            cancelledNow := watchSide
            watchSide := 0
            watchGuard := na
        bool oldBuyZone = rangeReady and bias == -1 and rawBuy and close >= extreme and close < broken
        bool oldSellZone = rangeReady and bias == 1 and rawSell and close > broken and close <= extreme
        if watchSide == 0 and ((oldBuyZone and allowLong) or (oldSellZone and allowShort))
            watchSide := selected
            watchGuard := origin
            armedNow := selected
int structureSide = touched != 0 ? touched : trendSide
int calcSide = selected != 0 ? selected : confirmNow

// Independent of structure: freeze the selected stop anchor on THIS close.
var int lastBuyBar = na
var int lastSellBar = na
float anchorPx = na
if calcSide != 0
    if stopMode == "Confirmed pivot (original chart)"
        anchorPx := calcSide == 1 ? knownL : knownH
    else
        int since = calcSide == 1 ? lastSellBar : lastBuyBar
        for k = 1 to pullbackBars
            if bar_index >= k and (na(since) or bar_index - k >= since)
                float w = calcSide == 1 ? low[k] : high[k]
                anchorPx := na(anchorPx) ? w : calcSide == 1 ? math.min(anchorPx, w) : math.max(anchorPx, w)
    if rawBuy
        lastBuyBar := bar_index
    else if rawSell
        lastSellBar := bar_index
float rawSL = anchorPx - calcSide * (atrBuffer * atr + extraPips * pipSize)
bool stopOK = calcSide != 0 and not na(rawSL) and rawSL > 0 and calcSide * (close - rawSL) > 0
bool emaOK = not useEma or (not na(ema) and calcSide * (close - ema) > 0)
bool exitGrade = stopOK and emaOK
float stopPlan = rawSL
if stopOK and stopMode == "Local pullback (bot)"
    // Outward rounding to the chart's trade tick; no hidden spread buffer.
    stopPlan := (calcSide == 1 ? math.floor(rawSL / syminfo.mintick + 1e-9) : math.ceil(rawSL / syminfo.mintick - 1e-9)) * syminfo.mintick

var array<line> planLines = array.new<line>()
var array<label> planTags = array.new<label>()
var int pendingSide = 0
var float pendingSL = na
var float pendingTP = na
var float pendingLo = na
var float pendingHi = na
var bool pendingOpenLo = false
var bool pendingOpenHi = false
var int pendingAt = na
var int side = 0
var float entry = na
var float stop = na
var float target = na
var float units = 0.0
var float entryFee = 0.0
var bool closeNext = false
var float cash = initialCapital
var float peak = initialCapital
var float maxDD = 0.0
var float totalNet = 0.0
var float grossWin = 0.0
var float grossLoss = 0.0
var int wins = 0
var int losses = 0
var int flats = 0
var int structureCount = 0
var int suggestionCount = 0
var int fillCount = 0
var int openVetoCount = 0
var string lastDecision = "Waiting for a cross"
float feeRate = commissionPercent / 100.0
float slip = slippageTicks * tickSize
int suggestion = 0
int filledSide = 0
int maybeCloseTie = 0
bool limitFilledInsideBar = false
float simFillPx = na
float simFillSL = na
float simFillTP = na

// Single-position chart proxy. Phase 0: prior position's opening gap/queued exit.
// Phase 1: try a frozen trend plan once at the adjacent open, OR a prior CHoCH
// limit on a later touch. The confirming bar cannot contribute a retest or a fill.
if barstate.isconfirmed
    for phase = 0 to 1
        if phase == 1 and (pendingSide != 0 or (touched != 0 and touchedOK))
            bool isLimit = touched != 0 and touchedOK and pendingSide == 0
            int pd = isLimit ? touched : pendingSide
            bool marketableOpen = isLimit and pd * (open - touchedPx) <= 0
            // A passive order cannot execute worse than its limit. No same-bar CHoCH fill.
            float px = not isLimit ? open + pd * slip : not marketableOpen ? touchedPx : pd == 1 ? math.min(touchedPx, open + slip) : math.max(touchedPx, open - slip)
            float sl = isLimit ? touchedSL : pendingSL
            float tp = isLimit ? touchedTP : pendingTP
            bool nextBar = isLimit or (not na(pendingAt) and time == pendingAt)
            bool frozenOK = isLimit or f_inside(px, pendingLo, pendingHi, pendingOpenLo, pendingOpenHi)
            bool bracketOK = pd * (open - sl) > 0 and pd * (px - sl) > 0 and pd * (tp - px) > 0
            float qty = px > 0 ? math.max(0.0, cash * equityPercent / 100.0) / (px * pointValue) : 0.0
            if side == 0 and nextBar and frozenOK and bracketOK and qty > 0
                side := pd
                filledSide := side
                if isLimit
                    retestFill := pd
                    limitFilledInsideBar := not marketableOpen
                    suggestion := pd
                    suggestionCount += 1
                    lastDecision := pd == 1 ? "BUY: retest filled" : "SELL: retest filled"
                fillCount += 1
                entry := px
                stop := sl
                target := tp
                simFillPx := px
                simFillSL := sl
                simFillTP := tp
                units := qty
                entryFee := math.abs(px * qty * pointValue) * feeRate
                cash -= entryFee
                if showPlan
                    if array.size(planLines) >= 3 * maxPlans
                        for k = 0 to 2
                            line.delete(array.shift(planLines))
                            label.delete(array.shift(planTags))
                    int endBar = bar_index + planLength
                    f_level(planLines, planTags, bar_index, endBar, entry, "Sim entry", #808080, line.style_dotted)
                    f_level(planLines, planTags, bar_index, endBar, stop, "SL", #EF4444, line.style_dashed)
                    f_level(planLines, planTags, bar_index, endBar, target, "TP", #16A34A, line.style_dashed)
            else
                openVetoCount += 1
                lastDecision := not nextBar ? "Veto: missing next bar" : not frozenOK ? "Veto: left frozen band" : "Veto: bracket/size/busy"
            pendingSide := 0
            pendingSL := na
            pendingTP := na
            pendingLo := na
            pendingHi := na
            pendingAt := na
        if side != 0
            bool isLong = side == 1
            float rawExit = na
            bool withSlip = false
            if phase == 0
                bool gapStop = isLong ? open <= stop : open >= stop
                bool gapTarget = isLong ? open >= target : open <= target
                if gapStop or gapTarget or closeNext
                    rawExit := open
                    withSlip := gapStop or not gapTarget
            else
                bool hitStop = isLong ? low <= stop : high >= stop
                // A favorable wick might precede an intrabar retest. Require proof AFTER fill.
                bool hitTarget = limitFilledInsideBar ? side * (close - target) >= 0 : isLong ? high >= target : low <= target
                if hitStop or hitTarget
                    rawExit := hitStop ? stop : target
                    withSlip := hitStop  // both touched: adverse barrier first
                    bool endedAtExtreme = hitStop ? (isLong ? close == low : close == high) : (isLong ? close == high : close == low)
                    if endedAtExtreme
                        maybeCloseTie := side  // OHLC cannot prove the exit preceded this signal close
            if not na(rawExit)
                float exitPx = rawExit - side * (withSlip ? slip : 0.0)
                float move = side * (exitPx - entry) * units * pointValue
                float exitFee = math.abs(exitPx * units * pointValue) * feeRate
                float pnl = move - entryFee - exitFee
                cash += move - exitFee
                totalNet += pnl
                if pnl > 1e-9
                    wins += 1
                    grossWin += pnl
                else if pnl < -1e-9
                    losses += 1
                    grossLoss -= pnl
                else
                    flats += 1
                side := 0
                entry := na
                stop := na
                target := na
                units := 0.0
                entryFee := 0.0
    // A qualified opposite may conditionally reverse, but the old exit is
    // independent of permission to enter. A repeat in an open trade never queues.
    closeNext := exitOpposite and side != 0 and selected == -side and exitGrade
    bool slotOK = (side == 0 or closeNext) and calcSide != maybeCloseTie
    bool sideAllowed = calcSide == 1 ? allowLong : allowShort
    if structureSide != 0
        structureCount += 1
    if confirmNow != 0
        // Structural touch can be inspected independently of risk/slot; vetoed plans never fill.
        retSide := confirmNow
        retLevel := broken
        retBar := bar_index
        retOK := sideAllowed and emaOK and stopOK and stopPlan > 0 and confirmNow * (broken - stopPlan) > 0 and slotOK and pendingSide == 0 and cash > 0
        retSL := retOK ? stopPlan : na
        retTP := retOK ? broken + (broken - stopPlan) * targetR : na
        placedNow := retOK ? confirmNow : 0
        lastDecision := retOK ? (confirmNow == 1 ? "BUY limit ready; wait retest" : "SELL limit ready; wait retest") : "CHoCH: chart plan vetoed"
    else if trendSide != 0 and retestFill == 0
        if not sideAllowed or not emaOK
            lastDecision := "Rejected: direction / EMA"
        else if not stopOK or stopPlan <= 0
            lastDecision := "Rejected: no valid stop"
        else if not slotOK or pendingSide != 0 or retOK
            lastDecision := "Rejected: chart slot reserved"
        else if cash <= 0
            lastDecision := "Rejected: no chart capital"
        else
            suggestion := trendSide
            suggestionCount += 1
            pendingSide := trendSide
            pendingSL := stopPlan
            pendingTP := close + (close - stopPlan) * targetR
            pendingLo := rawBuy ? buyLo : sellLo
            pendingHi := rawBuy ? buyHi : sellHi
            pendingOpenLo := rawBuy
            pendingOpenHi := rawSell
            pendingAt := time_close
            lastDecision := rawBuy ? "BUY: bullish discount" : "SELL: bearish premium"
    else if retestFill == 0
        if armedNow != 0
            lastDecision := armedNow == 1 ? "Watch BUY; no order" : "Watch SELL; no order"
        else if cancelledNow != 0
            lastDecision := "Watch / retest cancelled"
        else if conflict
            lastDecision := "Rejected: conflicting crosses"
        else if repeatSkipped
            lastDecision := "Rejected: alternation setting"
        else if selected != 0
            lastDecision := "Rejected: no entry zone"
    float marked = cash + (side == 0 ? 0.0 : (close - entry) * side * units * pointValue)
    peak := math.max(peak, marked)
    maxDD := math.max(maxDD, peak - marked)

// The view controls BOTH BUY/SELL marks and the two selectable alert conditions.
// It cannot change structural state, plan eligibility, exits, or what gets filled.
int displaySide = switch labelMode
    "Structure only (bands / retests)" => structureSide
    "Simulated fills only" => filledSide
    "All Hull crosses (debug)" => selected
    => suggestion
var int lastDisplay = 0
if displaySide != 0
    lastDisplay := displaySide
color stateInk = lastDisplay == 1 ? #15803D : lastDisplay == -1 ? #C6354C : #64748B
plot(b, "Hull B (close)", color=stateInk, linewidth=2, style=plot.style_linebr)
ph = plot(showChannel ? channelHi : na, "Hull A (high)", color=#CE6374, style=plot.style_linebr)
pl = plot(showChannel ? channelLo : na, "Hull A (low)", color=#269B83, style=plot.style_linebr)
fill(ph, pl, color=showChannel and channelFill ? color.new(stateInk, 89) : na, title="Last displayed side", fillgaps=false)
plot(useEma and showEma ? ema : na, "Optional chart EMA", color=#F59E0B, linewidth=2)
bp1 = plot(showBands ? buyLo : na, "Active BUY band low", color=#259981, style=plot.style_linebr)
bp2 = plot(showBands ? buyHi : na, "Active BUY band high", color=#259981, style=plot.style_linebr)
sp1 = plot(showBands ? sellLo : na, "Active SELL band low", color=#C85866, style=plot.style_linebr)
sp2 = plot(showBands ? sellHi : na, "Active SELL band high", color=#C85866, style=plot.style_linebr)
fill(bp1, bp2, color=color.new(#259981, 90), title="BUY structure band", fillgaps=false)
fill(sp1, sp2, color=color.new(#C85866, 90), title="SELL structure band", fillgaps=false)
plotshape(showCross and displaySide == 1, title="BUY · selected view", style=shape.labelup, location=location.belowbar, color=#15803D, text="BUY", textcolor=color.white, size=size.tiny)
plotshape(showCross and displaySide == -1, title="SELL · selected view", style=shape.labeldown, location=location.abovebar, color=#C6354C, text="SELL", textcolor=color.white, size=size.tiny)
plotshape(showCross and labelMode == "All Hull crosses (debug)" and conflict, title="Debug: conflict (no signal)", style=shape.xcross, location=location.abovebar, color=#C47B12, size=size.tiny)
alertcondition(displaySide == 1, title="Hull BUY · selected view", message="Hull BUY | {{ticker}} | {{interval}} | selected chart view | bar close {{close}}")
alertcondition(displaySide == -1, title="Hull SELL · selected view", message="Hull SELL | {{ticker}} | {{interval}} | selected chart view | bar close {{close}}")
// Stage alerts are deliberately separate from the selected BUY/SELL entry alerts.
alertcondition(placedNow == 1, title="BUY retest limit ready · not filled", message="Confirmed bullish CHoCH. Chart BUY retest limit staged; no fill yet. {{ticker}} {{interval}}")
alertcondition(placedNow == -1, title="SELL retest limit ready · not filled", message="Confirmed bearish CHoCH. Chart SELL retest limit staged; no fill yet. {{ticker}} {{interval}}")
plot(showStages and watchSide != 0 ? watchGuard : na, "Watch guard · no order", color=#AB813D, style=plot.style_circles)
plot(showStages and retOK ? retLevel : na, "Resting simulated limit", color=#5869AC, linewidth=2, style=plot.style_linebr)
plotshape(showStages and placedNow != 0 ? retLevel : na, title="Limit staged · NOT a fill", style=shape.diamond, location=location.absolute, color=#5869AC, size=size.tiny)
plot(simFillPx, "Simulated fill price", display=display.data_window)
plot(midRange, "BOS range midpoint", display=display.data_window)
plot(watchSide, "Watch side · not an entry", display=display.data_window)
plot(armedNow, "Watch armed on this close", display=display.data_window)
plot(confirmNow, "CHoCH watch or fresh cross confirmed", display=display.data_window)
plot(placedNow, "Retest limit staged on this close", display=display.data_window)
plot(touched, "Later structural retest touch", display=display.data_window)
plot(retestFill, "Later simulated retest fill", display=display.data_window)
plot(cancelledNow, "Watch or unfilled retest cancelled", display=display.data_window)
plot(selected, "Raw cross (+1/-1/0)", display=display.data_window)
plot(structureSide, "Structure pass at close (+1/-1/0)", display=display.data_window)
plot(suggestion, "Valid chart suggestion (+1/-1/0)", display=display.data_window)
plot(filledSide, "Simulated chart fill (+1/-1/0)", display=display.data_window)
plot(conflict ? 1 : 0, "Source conflict", display=display.data_window)
plot(origin, "Protected HL/LH", display=display.data_window)
plot(extreme, "Confirmed structural HH/LL", display=display.data_window)
plot(reaction, "Candidate pullback wick (not protected)", display=display.data_window)
plot(bias, "Structure bias (+1/-1/0)", display=display.data_window)
plot(breakNow ? bias * eventKind : 0, "Break on this close (signed 2 CHoCH / 3 BOS)", display=display.data_window)
plot(seenPullback ? 1 : 0, "Pullback seen (1/0)", display=display.data_window)
// Last confirmed simulation state. Closed-trade statistics do not liquidate an
// open position at the right edge. Gross loss is tracked as a positive magnitude.
int done = wins + losses + flats
string corner = switch tableLocation
    "top_left" => position.top_left
    "bottom_right" => position.bottom_right
    "bottom_left" => position.bottom_left
    => position.top_right
var table stats = table.new(corner, 2, 18, bgcolor=color.new(#0F172A, 8), frame_color=#475569, frame_width=1)
f_row(table t, int row, string name, string value) =>
    table.cell(t, 0, row, name, text_halign=text.align_left, text_color=row == 0 ? #FACC15 : #CBD5E1, text_size=size.small)
    table.cell(t, 1, row, value, text_halign=text.align_right, text_color=color.white, text_size=size.small)

if showTable and barstate.islast
    float winRate = done > 0 ? 100.0 * wins / done : na
    float pf = grossLoss > 0 ? grossWin / grossLoss : na
    float avgWin = wins > 0 ? grossWin / wins : na
    float avgLoss = losses > 0 ? -grossLoss / losses : na
    f_row(stats, 0, "FC RANGE 3 · CHART SIM", syminfo.ticker)
    f_row(stats, 1, "Trades · W/L/BE", str.tostring(done) + " · " + str.tostring(wins) + "/" + str.tostring(losses) + "/" + str.tostring(flats))
    f_row(stats, 2, "Win rate", done > 0 ? f_num(winRate) + "%" : "—")
    f_row(stats, 3, "Net / avg", f_num(totalNet) + " / " + f_num(done > 0 ? totalNet / done : na))
    f_row(stats, 4, "PF / max DD", f_num(pf) + " / " + f_num(maxDD))
    f_row(stats, 5, "Avg win / loss", f_num(avgWin) + " / " + f_num(avgLoss))
    f_row(stats, 6, "Position", side == 1 ? "BUY open" : side == -1 ? "SELL open" : "Flat")
    f_row(stats, 7, "SL / TP", side == 0 ? "—" : f_price(stop) + " / " + f_price(target))
    f_row(stats, 8, "EMA / target R", (useEma ? str.tostring(emaLength) : "Off") + " / " + str.tostring(targetR))
    f_row(stats, 9, "Pip size", str.tostring(pipSize, "0.########"))
    f_row(stats, 10, "Mode / length", sourceMode + " / " + str.tostring(hullLen))
    f_row(stats, 11, "Raw BUY / SELL", str.tostring(buyLabels) + " / " + str.tostring(sellLabels))
    f_row(stats, 12, "Conflicts / alternate skips", str.tostring(conflicts) + " / " + str.tostring(repeats))
    string phaseName = eventKind <= 1 ? "Context only" : rangeReady ? (bias == 1 ? "Discount active" : "Premium active") : eventKind == 3 ? "Wait HH/LL" : "No trend band"
    phaseName += na(origin) ? "" : " / guard " + f_price(origin)
    f_row(stats, 13, "Structure", (eventKind == 3 ? "BOS · " : eventKind == 2 ? "CHoCH · " : "") + phaseName)
    f_row(stats, 14, "Structure / valid closes", str.tostring(structureCount) + " / " + str.tostring(suggestionCount))
    f_row(stats, 15, "Chart fills / open vetoes", str.tostring(fillCount) + " / " + str.tostring(openVetoCount))
    f_row(stats, 16, "Last decision", lastDecision)
    f_row(stats, 17, "Reversal stage", retOK ? (retSide == 1 ? "BUY limit " : "SELL limit ") + f_price(retLevel) : watchSide != 0 ? (watchSide == 1 ? "Watch BUY > " : "Watch SELL < ") + f_price(watchGuard) : "—")
