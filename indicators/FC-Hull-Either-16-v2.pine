//@version=6
indicator("FC Hull v2 · Either source 16", shorttitle="FC E16 v2", overlay=true)
// Raw signal companion. TradingView cannot see the MT5 tickets, executable bid/ask,
// or the scanner's structure/admission checks. These alerts are NOT entry orders.
bool showLabels = input.bool(true, "Show raw signals (including repeats while MT5 may be busy)")
bool showCurves = input.bool(true, "Show Hull curves")

f_wma(float x, simple int n) =>
    float weighted = ta.wma(nz(x, 0.0), n)
    float available = math.sum(na(x) ? 0.0 : 1.0, n)
    available == n ? weighted : na

f_a(float src) =>
    f_wma(2 * f_wma(src, 8) - f_wma(src, 16), 4)

float lo = f_a(low)
float hi = f_a(high)
float b = f_wma(3 * f_wma(close, 2) - f_wma(close, 4) - f_wma(close, 8), 8)

f_cross(float a, float base) =>
    bool ready = barstate.isconfirmed and not na(a) and not na(a[1]) and not na(base) and not na(base[1])
    ready and base > a and base[1] < a[1] ? 1 : ready and base < a and base[1] > a[1] ? -1 : 0

int lowCross = f_cross(lo, b)
int highCross = f_cross(hi, b)
bool conflict = lowCross != 0 and highCross == -lowCross
int direction = conflict ? 0 : lowCross != 0 ? lowCross : highCross
plot(showCurves ? lo : na, "Hull A · low", color=#259981)
plot(showCurves ? hi : na, "Hull A · high", color=#C85866)
plot(showCurves ? b : na, "Hull B · close", color=#47658D, linewidth=2)
plotshape(showLabels and direction == 1, "Raw BUY", shape.labelup, location.belowbar, #147A5B, text="BUY", textcolor=color.white, size=size.tiny)
plotshape(showLabels and direction == -1, "Raw SELL", shape.labeldown, location.abovebar, #B5424C, text="SELL", textcolor=color.white, size=size.tiny)
plotshape(showLabels and conflict, "Conflict · no signal", shape.xcross, location.abovebar, #C47B12, size=size.tiny)
plot(direction, "Selected Hull signal (+1 / -1 / 0)", display=display.data_window)
plot(lowCross, "Low-source cross (+1 / -1 / 0)", display=display.data_window)
plot(highCross, "High-source cross (+1 / -1 / 0)", display=display.data_window)
plot(conflict ? 1 : 0, "Conflict skipped", display=display.data_window)
alertcondition(direction == 1, "Raw Either 16 BUY", "Either 16 raw BUY | {{ticker}} | {{interval}} | confirmed {{close}}")
alertcondition(direction == -1, "Raw Either 16 SELL", "Either 16 raw SELL | {{ticker}} | {{interval}} | confirmed {{close}}")
