# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── MetaTrader 5 Desktop Credentials (Windows Local Terminal) ──
# Leave MT5_LOGIN empty to attach to the currently logged-in MT5 terminal.
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""
MT5_TERMINAL_PATH=""
MT5_SYMBOL="XAUUSDm"

# ── Telegram Bot Control Plane ──
# Create a bot via @BotFather and get your numeric chat ID via @userinfobot
TELEGRAM_BOT_TOKEN="CHANGE_ME_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="CHANGE_ME_TELEGRAM_CHAT_ID"

# ── Optional TradingView Webhook Secret ──
WEBHOOK_SECRET="CHANGE_ME_SECRET"
