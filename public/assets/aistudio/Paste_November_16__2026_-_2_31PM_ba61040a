//@version=6
strategy("Wickless Structure Strategy", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, max_bars_back = 5000,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10)

// ── Wickless candle ──
tolTicks     = input.float(0.0, "Wick tolerance (ticks)", minval = 0.0, step = 1.0, group = "Wickless candle")
minBodyTicks = input.float(0.0, "Minimum body size (ticks)", minval = 0.0, step = 1.0, group = "Wickless candle")
showRaw      = input.bool(true, "Show wickless candles that failed the rules (faded)", group = "Wickless candle")

// ── Entry ──
entryMode    = input.string("Retest: limit at zone edge", "Entry mode", options = ["Retest: limit at zone edge", "Retest: rejection candle close", "Immediate (on candle close)"], group = "Entry")
pipSizeIn    = input.float(0.0, "Pip size in price units (0 = auto)", minval = 0.0, step = 0.01, group = "Entry", tooltip = "0 = auto: 0.1 for XAU, otherwise 10 x the minimum tick.")
zonePips     = input.float(3.0, "Entry zone size beyond the candle region (pips)", minval = 0.0, step = 0.5, group = "Entry")
needReject   = input.bool(true, "Require a rejection candle in the zone", group = "Entry", tooltip = "Only applies to rejection-candle close mode, not limit mode.")
retestBars   = input.int(10, "Retest window (bars)", minval = 1, group = "Entry", tooltip = "Bars allowed after the wickless candle, including the last one. An unfilled setup expires at that bar's close.")
cancelOnFlip = input.bool(true, "Cancel waiting setup if internal trend flips against it", group = "Entry")
showZone     = input.bool(true, "Draw entry zone box", group = "Entry")

// ── Market structure ──
useStructure = input.bool(true, "Use market structure (master switch)", group = "Market structure")
intLen       = input.int(3, "Internal swing length", minval = 1, group = "Market structure")
extLen       = input.int(10, "External swing length", minval = 2, group = "Market structure")
zoneBars     = input.int(15, "CHOCH zone: bars after the shift", minval = 1, group = "Market structure")
showInternal = input.bool(true, "Show internal structure", group = "Market structure")
showExternal = input.bool(false, "Show external structure", group = "Market structure")
showSwings   = input.bool(true, "Show HH / HL / LH / LL", group = "Market structure")
showBOS      = input.bool(true, "Show BOS", group = "Market structure")
showMSS      = input.bool(true, "Show MSS / CHOCH", group = "Market structure")
showIntHL    = input.bool(true, "Internal trend highlighter (ribbon at bottom)", group = "Market structure")
showExtHL    = input.bool(false, "External trend highlighter (background tint)", group = "Market structure")
showProt     = input.bool(false, "Show protected level (the level whose close flips the internal trend)", group = "Market structure")

// ── Trend lines ──
showTL       = input.bool(true, "Draw trend lines through HH / HL / LH / LL", group = "Trend lines")
tlSource     = input.string("External", "Trend line source", options = ["External", "Internal", "Both"], group = "Trend lines")
tlBull       = input.bool(true, "Bullish lines (through HH and HL)", group = "Trend lines")
tlBear       = input.bool(true, "Bearish lines (through LH and LL)", group = "Trend lines")

// ── Consolidation: context only, never blocks a setup ──
useConsol      = input.bool(true, "Detect consolidation (context only; does not block entries)", group = "Consolidation")
useConsolRange = input.bool(true, "Detect by range compression (ATR)", group = "Consolidation")
consolBars     = input.int(20, "Range lookback (bars)", minval = 5, group = "Consolidation")
consolMult     = input.float(3.5, "Range < ATR(14) x", minval = 1.0, step = 0.25, group = "Consolidation")
useConsolMixed = input.bool(true, "Detect by mixed swings", group = "Consolidation")
showConsol     = input.bool(true, "Highlight consolidation (grey tint)", group = "Consolidation")

// ── Trade plan ──
allowLongs   = input.bool(true, "Allow longs", group = "Trade plan")
allowShorts  = input.bool(true, "Allow shorts", group = "Trade plan")
placeTrades  = input.bool(true, "Place trades (off = suggestions only)", group = "Trade plan")
slLive       = input.bool(true, "SL uses the latest swing even if not yet confirmed", group = "Trade plan")
slBufTicks   = input.float(0.0, "SL buffer (ticks)", minval = 0.0, step = 1.0, group = "Trade plan")
tpMode       = input.string("Fixed R:R", "TP mode", options = ["Fixed R:R", "Structure (HH/LL) with R:R fallback"], group = "Trade plan")
rrValue      = input.float(1.0, "R:R (1.0 = 1:1)", minval = 0.25, step = 0.25, group = "Trade plan")
minRR        = input.float(1.0, "Minimum R:R (Structure mode only)", minval = 0.0, step = 0.25, group = "Trade plan")
showPlan     = input.bool(true, "Draw entry / TP / SL", group = "Trade plan")
planBars     = input.int(15, "Plan line length (bars)", minval = 3, group = "Trade plan")
showResults  = input.bool(true, "Show ✔ / ✖ when a trade hits TP / SL", group = "Backtest markers")

// ── Style ──
upColor      = input.color(color.new(color.green, 0), "Bullish colour", group = "Style")
downColor    = input.color(color.new(color.red, 0), "Bearish colour", group = "Style")
extUpColor   = input.color(color.new(color.blue, 0), "External bullish colour", group = "Style")
extDownColor = input.color(color.new(color.orange, 0), "External bearish colour", group = "Style")
showStats    = input.bool(true, "Show statistics table", group = "Style")
tablePos     = input.string("top_right", "Table position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = "Style")

// ══════════════════════ STRUCTURE ENGINE ═════════════════════
// Trend flips at the CLOSE that breaks the protected level (MSS). BOS = close beyond the structural swing.
//  - structural high / low : the extreme of the current leg (a new pivot extreme, or the first pivot after a structure event)
//  - protected low / high  : the pullback low / high under / over the last BOS (or the leg extreme after an MSS)
f_structure(int len, int zoneLen, bool isInt) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var int   trend = 0
    var float lastHigh = na
    var int   lastHighBar = na
    var float lastLow = na
    var int   lastLowBar = na
    var float lastHH = na
    var float lastHL = na
    var float lastLL = na
    var float lastLH = na
    var int   hiType = 0
    var int   loType = 0
    var float bosHi = na
    var int   bosHiBar = na
    var bool  bosHiX = true
    var float bosLo = na
    var int   bosLoBar = na
    var bool  bosLoX = true
    var float rl = na
    var int   rlBar = na
    var float rh = na
    var int   rhBar = na
    var float protLow = na
    var int   protLowBar = na
    var float protHigh = na
    var int   protHighBar = na
    var int   evBar = -1
    var int   chochDir = 0
    var float chochLvl = na
    var int   chochBar = na

    bool on = useStructure and (isInt ? showInternal : showExternal)
    color cBull = isInt ? upColor : extUpColor
    color cBear = isInt ? downColor : extDownColor
    string sz = isInt ? size.tiny : size.small
    color clear = color.new(color.white, 100)

    if barstate.isconfirmed
        int pj = bar_index - len
        if not na(ph)
            if not na(lastHigh)
                if ph > lastHigh
                    lastHH := ph
                    hiType := 1
                    if on and showSwings
                        label.new(pj, ph, "HH", style = label.style_label_down, color = clear, textcolor = cBull, size = sz)
                else if ph < lastHigh
                    lastLH := ph
                    hiType := -1
                    if on and showSwings
                        label.new(pj, ph, "LH", style = label.style_label_down, color = clear, textcolor = cBear, size = sz)
            lastHigh := ph
            lastHighBar := pj
            if pj >= evBar and (na(bosHi) or bosHiX or ph > bosHi)
                bosHi := ph
                bosHiBar := pj
                bosHiX := false
                rl := na
                rlBar := na
                if len > 1
                    for k = 1 to len - 1
                        if na(rl) or low[k] < rl
                            rl := low[k]
                            rlBar := bar_index - k
        if not na(pl)
            if not na(lastLow)
                if pl > lastLow
                    lastHL := pl
                    loType := 1
                    if on and showSwings
                        label.new(pj, pl, "HL", style = label.style_label_up, color = clear, textcolor = cBull, size = sz)
                else if pl < lastLow
                    lastLL := pl
                    loType := -1
                    if on and showSwings
                        label.new(pj, pl, "LL", style = label.style_label_up, color = clear, textcolor = cBear, size = sz)
            lastLow := pl
            lastLowBar := pj
            if pj >= evBar and (na(bosLo) or bosLoX or pl < bosLo)
                bosLo := pl
                bosLoBar := pj
                bosLoX := false
                rh := na
                rhBar := na
                if len > 1
                    for k = 1 to len - 1
                        if na(rh) or high[k] > rh
                            rh := high[k]
                            rhBar := bar_index - k

        bool done = false
        if trend == -1 and not na(protHigh) and close > protHigh
            // MSS up: close above the protected high. The trend flips now.
            float legLow = na
            int legLowBar = na
            int cnt = na(protHighBar) ? 0 : math.min(bar_index - 1 - protHighBar, 1500)
            if cnt >= 1
                for k = 1 to cnt
                    if na(legLow) or low[k] < legLow
                        legLow := low[k]
                        legLowBar := bar_index - k
            if on and showMSS and not na(protHighBar)
                line.new(protHighBar, protHigh, bar_index, protHigh, color = cBull, style = line.style_solid, width = isInt ? 2 : 3)
                label.new(math.round((protHighBar + bar_index) / 2), protHigh, "MSS", style = label.style_label_down, color = cBull, textcolor = color.white, size = sz)
            chochDir := 1
            chochBar := bar_index
            chochLvl := na(legLow) ? lastLow : legLow
            trend := 1
            protLow := legLow
            protLowBar := legLowBar
            protHigh := na
            protHighBar := na
            lastLL := na
            lastLH := na
            hiType := 0
            loType := 0
            bosHi := na
            bosHiX := true
            bosLo := na
            bosLoX := true
            evBar := bar_index
            done := true
        else if trend == 1 and not na(protLow) and close < protLow
            // MSS down: close below the protected low. The trend flips now.
            float legHigh = na
            int legHighBar = na
            int cnt = na(protLowBar) ? 0 : math.min(bar_index - 1 - protLowBar, 1500)
            if cnt >= 1
                for k = 1 to cnt
                    if na(legHigh) or high[k] > legHigh
                        legHigh := high[k]
                        legHighBar := bar_index - k
            if on and showMSS and not na(protLowBar)
                line.new(protLowBar, protLow, bar_index, protLow, color = cBear, style = line.style_solid, width = isInt ? 2 : 3)
                label.new(math.round((protLowBar + bar_index) / 2), protLow, "MSS", style = label.style_label_up, color = cBear, textcolor = color.white, size = sz)
            chochDir := -1
            chochBar := bar_index
            chochLvl := na(legHigh) ? lastHigh : legHigh
            trend := -1
            protHigh := legHigh
            protHighBar := legHighBar
            protLow := na
            protLowBar := na
            lastHH := na
            lastHL := na
            hiType := 0
            loType := 0
            bosHi := na
            bosHiX := true
            bosLo := na
            bosLoX := true
            evBar := bar_index
            done := true

        if not done
            if trend != -1 and not na(bosHi) and not bosHiX and close > bosHi
                // BOS up: close above the structural high. Protected low = the pullback low under it.
                bosHiX := true
                if on and showBOS
                    line.new(bosHiBar, bosHi, bar_index, bosHi, color = cBull, style = line.style_dashed, width = isInt ? 1 : 2)
                    label.new(math.round((bosHiBar + bar_index) / 2), bosHi, "BOS", style = label.style_label_down, color = cBull, textcolor = color.white, size = sz)
                if not na(rlBar)
                    protLow := rl
                    protLowBar := rlBar
                else if na(protLow) and not na(lastLow) and lastLow < close
                    protLow := lastLow
                    protLowBar := lastLowBar
                trend := 1
                if chochDir == 1
                    chochDir := 0
                evBar := bar_index
            else if trend != 1 and not na(bosLo) and not bosLoX and close < bosLo
                // BOS down: close below the structural low. Protected high = the pullback high above it.
                bosLoX := true
                if on and showBOS
                    line.new(bosLoBar, bosLo, bar_index, bosLo, color = cBear, style = line.style_dashed, width = isInt ? 1 : 2)
                    label.new(math.round((bosLoBar + bar_index) / 2), bosLo, "BOS", style = label.style_label_up, color = cBear, textcolor = color.white, size = sz)
                if not na(rhBar)
                    protHigh := rh
                    protHighBar := rhBar
                else if na(protHigh) and not na(lastHigh) and lastHigh > close
                    protHigh := lastHigh
                    protHighBar := lastHighBar
                trend := -1
                if chochDir == -1
                    chochDir := 0
                evBar := bar_index

        // pullback extremes run up to the previous bar when the next bar is checked
        if not na(bosHi) and (na(rl) or low < rl)
            rl := low
            rlBar := bar_index
        if not na(bosLo) and (na(rh) or high > rh)
            rh := high
            rhBar := bar_index

    bool chochOn = chochDir != 0 and (bar_index - chochBar) <= zoneLen
    [trend, lastHH, lastHL, lastLL, lastLH, lastHigh, lastLow, chochDir, chochLvl, chochOn, hiType, loType, lastHighBar, lastLowBar, protHigh, protLow]

f_provHigh(int fromBar) =>
    float h = na
    if not na(fromBar)
        int n = bar_index - 1 - fromBar
        if n >= 1
            for k = 1 to math.min(n, 300)
                h := na(h) ? high[k] : math.max(h, high[k])
    h

f_provLow(int fromBar) =>
    float l = na
    if not na(fromBar)
        int n = bar_index - 1 - fromBar
        if n >= 1
            for k = 1 to math.min(n, 300)
                l := na(l) ? low[k] : math.min(l, low[k])
    l

f_plan(bool isLong, float entry, float tp, float sl, string tag) =>
    float rr = math.abs(tp - entry) / math.abs(entry - sl)
    line.new(bar_index, tp, bar_index + planBars, tp, color = color.green, style = line.style_dashed)
    line.new(bar_index, sl, bar_index + planBars, sl, color = color.red, style = line.style_dashed)
    line.new(bar_index, entry, bar_index + planBars, entry, color = color.gray, style = line.style_dotted)
    label.new(bar_index + planBars, tp, "TP " + str.tostring(tp, format.mintick), style = label.style_label_left, color = color.green, textcolor = color.white, size = size.tiny)
    label.new(bar_index + planBars, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.red, textcolor = color.white, size = size.tiny)
    label.new(bar_index + planBars, entry, (isLong ? "BUY · " : "SELL · ") + tag + " · RR " + str.tostring(rr, "#.##"), style = label.style_label_left, color = color.gray, textcolor = color.white, size = size.tiny)

// Connects the two latest swing highs and the two latest swing lows, extended to the right.
// Only the newest line of each kind is kept.
f_trendlines(int len, bool on, bool wantBull, bool wantBear, color cUp, color cDn, int w) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float prevH = na
    var int   prevHBar = na
    var float prevL = na
    var int   prevLBar = na
    var line  hhLine = na
    var line  lhLine = na
    var line  hlLine = na
    var line  llLine = na
    if not na(ph)
        int pb = bar_index - len
        if not na(prevH)
            if not na(hhLine)
                line.delete(hhLine)
                hhLine := na
            if not na(lhLine)
                line.delete(lhLine)
                lhLine := na
            if on
                if ph > prevH and wantBull
                    hhLine := line.new(prevHBar, prevH, pb, ph, extend = extend.right, color = cUp, width = w)
                else if ph <= prevH and wantBear
                    lhLine := line.new(prevHBar, prevH, pb, ph, extend = extend.right, color = cDn, width = w)
        prevH := ph
        prevHBar := pb
    if not na(pl)
        int pb = bar_index - len
        if not na(prevL)
            if not na(hlLine)
                line.delete(hlLine)
                hlLine := na
            if not na(llLine)
                line.delete(llLine)
                llLine := na
            if on
                if pl > prevL and wantBull
                    hlLine := line.new(prevLBar, prevL, pb, pl, extend = extend.right, color = cUp, width = w)
                else if pl <= prevL and wantBear
                    llLine := line.new(prevLBar, prevL, pb, pl, extend = extend.right, color = cDn, width = w)
        prevL := pl
        prevLBar := pb

[iTrend, iLastHH, iLastHL, iLastLL, iLastLH, iLastHigh, iLastLow, iChochDir, iChochLvl, iChochOn, iHiType, iLoType, iLastHighBar, iLastLowBar, iProtHigh, iProtLow] = f_structure(intLen, zoneBars, true)
[eTrend, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _] = f_structure(extLen, zoneBars, false)

f_trendlines(extLen, showTL and tlSource != "Internal", tlBull, tlBear, extUpColor, extDownColor, 2)
f_trendlines(intLen, showTL and tlSource != "External", tlBull, tlBear, upColor, downColor, 1)

plotshape(useStructure and showIntHL and iTrend != 0, "Internal trend", shape.square, location.bottom, iTrend == 1 ? upColor : downColor, size = size.tiny)
bgcolor(useStructure and showExtHL and eTrend != 0 ? (eTrend == 1 ? color.new(extUpColor, 90) : color.new(extDownColor, 90)) : na, title = "External trend")
plot(useStructure and showProt and iTrend == 1 ? iProtLow : na, "Protected low", color = color.new(upColor, 30), style = plot.style_linebr, linewidth = 1)
plot(useStructure and showProt and iTrend == -1 ? iProtHigh : na, "Protected high", color = color.new(downColor, 30), style = plot.style_linebr, linewidth = 1)

float atrVal = ta.atr(14)
float rangeN = ta.highest(high, consolBars) - ta.lowest(low, consolBars)
bool consolRange = useConsolRange and rangeN < atrVal * consolMult
bool consolMixed = useConsolMixed and (iHiType * iLoType == -1)
bool consolidating = useConsol and (consolRange or consolMixed)
bgcolor(showConsol and consolidating ? color.new(color.gray, 85) : na, title = "Consolidation")

// ══════════════════════ WICKLESS DETECTION ═════════════════
tol = tolTicks * syminfo.mintick
minBody = minBodyTicks * syminfo.mintick
buf = slBufTicks * syminfo.mintick
body = math.abs(close - open)
bodyOk = body >= minBody and body > 0
rawBull = close > open and (open - low) <= tol and bodyOk
rawBear = close < open and (high - open) <= tol and bodyOk
confirmed = barstate.isconfirmed
bool mImmediate = entryMode == "Immediate (on candle close)"
bool mReject = entryMode == "Retest: rejection candle close"
bool mLimit = entryMode == "Retest: limit at zone edge"
bool retest = not mImmediate
float autoPip = str.contains(syminfo.ticker, "XAU") ? 0.1 : syminfo.mintick * 10
float pip = pipSizeIn > 0 ? pipSizeIn : autoPip
float zoneBuf = zonePips * pip

float lSL = na
float lStructTP = na
string lTag = ""
if rawBull and allowLongs
    if not useStructure
        lSL := open - buf
        lTag := "Wickless"
    else if iChochOn and iChochDir == 1
        lSL := iChochLvl - buf
        lTag := "CHOCH"
    else if iTrend == 1
        float provL = slLive ? f_provLow(iLastLowBar) : na
        lStructTP := iLastHH > close ? iLastHH : na
        lSL := (not na(provL) and provL < close) ? provL - buf : (iLastHL < close ? iLastHL - buf : (iLastLow < close ? iLastLow - buf : open - buf))
        lTag := "Trend"
float lRef = retest ? open + zoneBuf : close
bool longSetup = confirmed and not na(lSL) and lSL < lRef

float sSLv = na
float sStructTP = na
string sTag = ""
if rawBear and allowShorts
    if not useStructure
        sSLv := open + buf
        sTag := "Wickless"
    else if iChochOn and iChochDir == -1
        sSLv := iChochLvl + buf
        sTag := "CHOCH"
    else if iTrend == -1
        float provH = slLive ? f_provHigh(iLastHighBar) : na
        sStructTP := iLastLL < close ? iLastLL : na
        sSLv := (not na(provH) and provH > close) ? provH + buf : (iLastLH > close ? iLastLH + buf : (iLastHigh > close ? iLastHigh + buf : open + buf))
        sTag := "Trend"
float sRef = retest ? open - zoneBuf : close
bool shortSetup = confirmed and not na(sSLv) and sSLv > sRef

// Setups and hypothetical outcome trackers. These can differ from strategy tester fills.
var array<int> sDir = array.new<int>()
var array<int> sBar = array.new<int>()
var array<float> sBot = array.new<float>()
var array<float> sTop = array.new<float>()
var array<float> sSL = array.new<float>()
var array<float> sSTP = array.new<float>()
var array<float> sEntry = array.new<float>()
var array<float> sTPa = array.new<float>()
var array<string> sTagA = array.new<string>()
var array<box> sBox = array.new<box>()
var array<int> pDir = array.new<int>()
var array<float> pTP = array.new<float>()
var array<float> pSL = array.new<float>()
var array<float> pRR = array.new<float>()
var int wins = 0
var int losses = 0
var int cancelled = 0
var float netR = 0.0
var int orderBar = na
bool longEntered = false
bool shortEntered = false
bool orderedThisBar = false

// Existing hypothetical trades: if both TP and SL are touched, count a loss.
if confirmed and pDir.size() > 0
    for i = pDir.size() - 1 to 0
        int d = pDir.get(i)
        float t = pTP.get(i)
        float s = pSL.get(i)
        bool hitTP = d == 1 ? high >= t : low <= t
        bool hitSL = d == 1 ? low <= s : high >= s
        if hitTP or hitSL
            bool win = hitTP and not hitSL
            if win
                wins += 1
                netR += pRR.get(i)
            else
                losses += 1
                netR -= 1.0
            if showResults
                label.new(bar_index, win ? t : s, win ? "✔" : "✖", style = label.style_label_center, color = color.new(color.white, 100), textcolor = win ? color.green : color.red, size = size.large)
            pDir.remove(i)
            pTP.remove(i)
            pSL.remove(i)
            pRR.remove(i)

if longSetup
    float lEntry = na
    float lTPp = na
    bool lOk = true
    if mLimit
        lEntry := open + zoneBuf
        float lr = lEntry - lSL
        if tpMode == "Fixed R:R"
            lTPp := lEntry + lr * rrValue
        else
            lTPp := (not na(lStructTP) and lStructTP > lEntry) ? lStructTP : lEntry + lr * rrValue
        lOk := lr > 0 and (tpMode == "Fixed R:R" or (lTPp - lEntry) / lr >= minRR)
    if lOk
        box lbx = na
        if showZone and retest
            lbx := box.new(bar_index, open + zoneBuf, bar_index + retestBars, math.min(open, low), border_color = color.new(upColor, 60), bgcolor = color.new(upColor, 85))
        sDir.push(1)
        sBar.push(bar_index)
        sBot.push(math.min(open, low))
        sTop.push(open + zoneBuf)
        sSL.push(lSL)
        sSTP.push(lStructTP)
        sEntry.push(lEntry)
        sTPa.push(lTPp)
        sTagA.push(lTag)
        sBox.push(lbx)
        if mLimit
            alert("BUY LIMIT " + syminfo.ticker + " [" + lTag + "] @ " + str.tostring(lEntry, format.mintick) + " (pending; expires after " + str.tostring(retestBars) + " bars)", alert.freq_once_per_bar_close)
            if placeTrades and strategy.position_size == 0 and na(orderBar)
                strategy.entry("Long", strategy.long, limit = lEntry)
                strategy.exit("Long exit", "Long", stop = lSL, limit = lTPp)
                orderBar := bar_index
if shortSetup
    float sEntryP = na
    float sTPp = na
    bool sOk = true
    if mLimit
        sEntryP := open - zoneBuf
        float sr = sSLv - sEntryP
        if tpMode == "Fixed R:R"
            sTPp := sEntryP - sr * rrValue
        else
            sTPp := (not na(sStructTP) and sStructTP < sEntryP) ? sStructTP : sEntryP - sr * rrValue
        sOk := sr > 0 and (tpMode == "Fixed R:R" or (sEntryP - sTPp) / sr >= minRR)
    if sOk
        box sbx = na
        if showZone and retest
            sbx := box.new(bar_index, math.max(open, high), bar_index + retestBars, open - zoneBuf, border_color = color.new(downColor, 60), bgcolor = color.new(downColor, 85))
        sDir.push(-1)
        sBar.push(bar_index)
        sBot.push(open - zoneBuf)
        sTop.push(math.max(open, high))
        sSL.push(sSLv)
        sSTP.push(sStructTP)
        sEntry.push(sEntryP)
        sTPa.push(sTPp)
        sTagA.push(sTag)
        sBox.push(sbx)
        if mLimit
            alert("SELL LIMIT " + syminfo.ticker + " [" + sTag + "] @ " + str.tostring(sEntryP, format.mintick) + " (pending; expires after " + str.tostring(retestBars) + " bars)", alert.freq_once_per_bar_close)
            if placeTrades and strategy.position_size == 0 and na(orderBar)
                strategy.entry("Short", strategy.short, limit = sEntryP)
                strategy.exit("Short exit", "Short", stop = sSLv, limit = sTPp)
                orderBar := bar_index

// A touch on the final allowed bar is eligible; otherwise expire at its close.
// strategy.cancel() affects the TradingView emulator's pending orders, not external broker orders.
if confirmed and sDir.size() > 0
    for i = sDir.size() - 1 to 0
        int d = sDir.get(i)
        int sb = sBar.get(i)
        int age = bar_index - sb
        float zb = sBot.get(i)
        float zt = sTop.get(i)
        float sl = sSL.get(i)
        string tag = sTagA.get(i)
        box bx = sBox.get(i)
        bool trig = false
        bool dead = false
        if mImmediate
            trig := age == 0
        else if age >= 1
            bool broken = mReject and (d == 1 ? (close < zb or low <= sl) : (close > zt or high >= sl))
            bool flipped = cancelOnFlip and useStructure and (d == 1 ? iTrend == -1 : iTrend == 1)
            bool touched = d == 1 ? low <= zt : high >= zb
            bool rejected = not mReject or not needReject or (d == 1 ? close > open : close < open)
            if broken
                dead := true
            else if touched and rejected
                trig := true
            else if age >= retestBars or flipped
                dead := true
        if trig
            float entry = mLimit ? sEntry.get(i) : close
            float risk = d == 1 ? entry - sl : sl - entry
            float tp = na
            if risk > 0
                if mLimit
                    tp := sTPa.get(i)
                else if tpMode == "Fixed R:R"
                    tp := d == 1 ? entry + risk * rrValue : entry - risk * rrValue
                else
                    float st = sSTP.get(i)
                    bool stOk = not na(st) and (d == 1 ? st > entry : st < entry)
                    tp := stOk ? st : (d == 1 ? entry + risk * rrValue : entry - risk * rrValue)
            float rr = na(tp) ? na : math.abs(tp - entry) / risk
            bool ok = risk > 0 and not na(tp) and (tpMode == "Fixed R:R" or rr >= minRR)
            if ok
                bool stoppedNow = mLimit and (d == 1 ? low <= sl : high >= sl)
                if d == 1
                    longEntered := true
                else
                    shortEntered := true
                if showPlan
                    f_plan(d == 1, entry, tp, sl, tag)
                alert((d == 1 ? "BUY " : "SELL ") + syminfo.ticker + " [" + tag + "] entry " + str.tostring(entry, format.mintick) + " TP " + str.tostring(tp, format.mintick) + " SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)
                if stoppedNow
                    losses += 1
                    netR -= 1.0
                    if showResults
                        label.new(bar_index, sl, "✖", style = label.style_label_center, color = color.new(color.white, 100), textcolor = color.red, size = size.large)
                else
                    pDir.push(d)
                    pTP.push(tp)
                    pSL.push(sl)
                    pRR.push(rr)
                if not mLimit and placeTrades and strategy.position_size == 0 and not orderedThisBar
                    orderedThisBar := true
                    if d == 1
                        strategy.entry("Long", strategy.long)
                        strategy.exit("Long exit", "Long", stop = sl, limit = tp)
                    else
                        strategy.entry("Short", strategy.short)
                        strategy.exit("Short exit", "Short", stop = sl, limit = tp)
                if sb == orderBar
                    orderBar := na
                if not na(bx)
                    box.set_right(bx, bar_index)
                    box.set_bgcolor(bx, color.new(d == 1 ? upColor : downColor, 65))
            else
                cancelled += 1
                label.new(sb, d == 1 ? zb : zt, "CANCELLED", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.gray, textcolor = color.white, size = size.tiny)
                if sb == orderBar
                    strategy.cancel(d == 1 ? "Long" : "Short")
                    strategy.cancel(d == 1 ? "Long exit" : "Short exit")
                    orderBar := na
                if not na(bx)
                    box.set_right(bx, bar_index)
                    box.set_bgcolor(bx, color.new(color.gray, 85))
        else if dead
            cancelled += 1
            label.new(sb, d == 1 ? zb : zt, "CANCELLED", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.gray, textcolor = color.white, size = size.tiny)
            if sb == orderBar
                strategy.cancel(d == 1 ? "Long" : "Short")
                strategy.cancel(d == 1 ? "Long exit" : "Short exit")
                orderBar := na
            if not na(bx)
                box.set_right(bx, bar_index)
                box.set_bgcolor(bx, color.new(color.gray, 85))
                box.set_border_color(bx, color.new(color.gray, 60))
        if trig or dead
            sDir.remove(i)
            sBar.remove(i)
            sBot.remove(i)
            sTop.remove(i)
            sSL.remove(i)
            sSTP.remove(i)
            sEntry.remove(i)
            sTPa.remove(i)
            sTagA.remove(i)
            sBox.remove(i)

plotshape(longEntered, "Buy entry", shape.labelup, location.belowbar, upColor, text = "BUY", textcolor = color.white, size = size.small)
plotshape(shortEntered, "Sell entry", shape.labeldown, location.abovebar, downColor, text = "SELL", textcolor = color.white, size = size.small)
plotshape(retest and longSetup, "Valid bullish wickless (waiting for retest)", shape.triangleup, location.belowbar, color.new(upColor, 30), size = size.tiny)
plotshape(retest and shortSetup, "Valid bearish wickless (waiting for retest)", shape.triangledown, location.abovebar, color.new(downColor, 30), size = size.tiny)
plotshape(showRaw and rawBull and not longSetup and confirmed, "Ignored bullish wickless", shape.triangleup, location.belowbar, color.new(color.gray, 60), size = size.tiny)
plotshape(showRaw and rawBear and not shortSetup and confirmed, "Ignored bearish wickless", shape.triangledown, location.abovebar, color.new(color.gray, 60), size = size.tiny)

var int bullCount = 0
var int bearCount = 0
if confirmed
    if rawBull
        bullCount += 1
    if rawBear
        bearCount += 1
tblPos = tablePos == "top_right" ? position.top_right : tablePos == "top_left" ? position.top_left : tablePos == "bottom_right" ? position.bottom_right : position.bottom_left
var table stats = table.new(tblPos, 2, 14, bgcolor = color.new(color.black, 20), border_width = 1)
f_trendTxt(int t) => t == 1 ? "Bullish" : t == -1 ? "Bearish" : "—"
if showStats and barstate.islast
    int total = wins + losses
    float winRate = total > 0 ? wins * 100.0 / total : na
    table.cell(stats, 0, 0, "Wickless strategy", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 0, "", text_color = color.white)
    table.cell(stats, 0, 1, "Bullish wickless", text_color = upColor, text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(bullCount), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 2, "Bearish wickless", text_color = downColor, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(bearCount), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 3, "Internal trend", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 3, f_trendTxt(iTrend), text_color = iTrend == 1 ? upColor : downColor, text_size = size.small)
    table.cell(stats, 0, 4, "External trend", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 4, f_trendTxt(eTrend), text_color = eTrend == 1 ? extUpColor : extDownColor, text_size = size.small)
    table.cell(stats, 0, 5, "Market state", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 5, consolidating ? "Consolidating" : "Trending", text_color = consolidating ? color.gray : color.white, text_size = size.small)
    table.cell(stats, 0, 6, "Entry zone (price)", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 6, str.tostring(zoneBuf, format.mintick), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 7, "Waiting for retest", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 7, str.tostring(sDir.size()), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 8, "Cancelled setups", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 8, str.tostring(cancelled), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 9, "Hit TP ✔", text_color = upColor, text_size = size.small)
    table.cell(stats, 1, 9, str.tostring(wins), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 10, "Hit SL ✖", text_color = downColor, text_size = size.small)
    table.cell(stats, 1, 10, str.tostring(losses), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 11, "Open trades", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 11, str.tostring(pDir.size()), text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 12, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 12, na(winRate) ? "—" : str.tostring(winRate, "#.#") + "%", text_color = color.white, text_size = size.small)
    table.cell(stats, 0, 13, "Net R", text_color = color.white, text_size = size.small)
    table.cell(stats, 1, 13, str.tostring(netR, "#.##") + "R", text_color = netR >= 0 ? upColor : downColor, text_size = size.small)